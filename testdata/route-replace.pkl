amends "@formae/forma.pkl"

import "@gcp/compute/route.pkl"
import "./config/vars.pkl" as v

// Static route in the default network to the default internet gateway.
forma {
  v.stack
  v.target

  new route.Route {
    label = "plugin-sdk-test-route"
    // The name is immutable, so changing it forces a replace rather than
    // an update: the old resource is destroyed and a new one takes its place.
    name = "formae-test-route-r2-\(v.testRunID)"
    description = "Test route for plugin SDK conformance tests"
    // Full self-link URLs - the Compute API canonicalizes refs to this form.
    network = "https://www.googleapis.com/compute/v1/projects/\(v.gcpProject)/global/networks/default"
    destRange = "10.123.0.0/24"
    priority = 1000
    nextHopGateway = "https://www.googleapis.com/compute/v1/projects/\(v.gcpProject)/global/gateways/default-internet-gateway"
  }
}
