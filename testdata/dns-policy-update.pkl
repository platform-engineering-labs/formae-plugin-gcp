amends "@formae/forma.pkl"

import "@gcp/dns/dnsPolicy.pkl" as dnsPolicy
import "@gcp/compute/network.pkl"
import "./config/vars.pkl" as v

// A policy applies to networks, so one comes first. Neither costs anything to
// hold - Cloud DNS bills zones and queries, and this policy answers none.
local net = new network.Network {
  label = "plugin-sdk-test-dnspolicy-network"
  name = "formae-plugin-sdk-test-dnsp-net-\(v.testRunID)"
  autoCreateSubnetworks = false
}

forma {
  v.stack
  v.target

  net

  new dnsPolicy.Policy {
    label = "plugin-sdk-test-dns-policy"
    project = v.gcpProject
    name = "formae-plugin-sdk-test-dnsp-\(v.testRunID)"
    description = "Plugin SDK conformance policy (updated)"
    enableInboundForwarding = false
    enableLogging = false
    networks = new Listing {
      new dnsPolicy.PolicyNetwork {
        // Resolvable -> the network exists before the policy attaches to it.
        networkUrl = net.res.selfLink
      }
    }
  }
}
