amends "@formae/forma.pkl"

import "@gcp/essentialcontacts/contact.pkl"
import "./config/vars.pkl" as v

// An essential contact stands on its own and costs nothing. Its id is assigned
// by the API, so the forma names no id - the run id goes in the address
// instead, which keeps concurrent runs from sharing a contact.
//
// The address is on example.com, which RFC 2606 reserves for exactly this: it
// can never route anywhere, so nothing is delivered to a real mailbox. The
// contact is never verified either, since a project's own notifications are
// the only thing that would exercise it.
forma {
  v.stack
  v.target

  new contact.Contact {
    label = "plugin-sdk-test-essentialcontacts-contact"
    email = "formae-conformance-\(v.testRunID)@example.com"
    languageTag = "en-GB"
    notificationCategorySubscriptions = new Listing {
      "TECHNICAL"
    }
  }
}
