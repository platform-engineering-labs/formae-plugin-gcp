amends "@formae/forma.pkl"

import "@gcp/bigtable/instance_bigtable.pkl" as instance
import "@gcp/bigtable/app_profile.pkl" as appProfile
import "./config/vars.pkl" as v

// The instance whose clusters the profile routes across. Same shape as the
// bigtable-instance case: DEVELOPMENT is the cheapest instance type.
local inst = new instance.Instance {
  label = "plugin-sdk-test-btap-instance"
  project = v.gcpProject
  name = "formae-test-btap-\(v.testRunID)"
  displayName = "Plugin SDK App Profile Host"
  type = "DEVELOPMENT"
  clusters = new Mapping {
    ["cluster1"] = new instance.ClusterConfig {
      location = "\(v.gcpRegion)-a"
      defaultStorageType = "SSD"
    }
  }
}

forma {
  v.stack
  v.target

  inst

  // The host instance has one cluster, so the profile pins traffic to it.
  // multiClusterRoutingUseAny needs an instance with more than one cluster.
  new appProfile.AppProfile {
    label = "plugin-sdk-test-bigtable-app-profile"
    name = "formae-test-btap-profile-\(v.testRunID)"
    instance = inst.res.name
    description = "Test app profile for plugin SDK conformance tests"
    singleClusterRouting = new appProfile.SingleClusterRouting {
      clusterId = "cluster1"
    }
  }
}
