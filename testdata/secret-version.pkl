amends "@formae/forma.pkl"

import "@gcp/secretmanager/secret.pkl"
import "@gcp/secretmanager/secretVersion.pkl"
import "./config/vars.pkl" as v

forma {
  // Parent secret. Referenced via its resolvable so formae creates it before
  // the version, and passes the full "projects/{p}/secrets/{id}" path.
  local s = new secret.Secret {
    label = "plugin-sdk-test-sv-secret"
    name = "formae-plugin-sdk-test-sv-\(v.testRunID)"
  }

  v.stack
  v.target

  s

  new secretVersion.SecretVersion {
    label = "plugin-sdk-test-secret-version"
    secret = s.res.name
    data = "formae-plugin-sdk-test-payload"
  }
}
