amends "@formae/forma.pkl"

import "@gcp/secretmanager/secret.pkl"
import "@gcp/secretmanager/secretVersion.pkl"
import "./config/vars.pkl" as v

forma {
  // Parent secret. Referenced via its resolvable so formae creates it before
  // the version, and passes the full "projects/{p}/secrets/{id}" path.
  local s = new secret.Secret {
    label = "plugin-sdk-test-sv-secret"
    name = "formae-plugin-sdk-test-sv-\(v.testRunID)"
  }

  v.stack
  v.target

  s

  new secretVersion.SecretVersion {
    label = "plugin-sdk-test-secret-version"
    secret = s.res.name
    // Plain string: the field is opaque-by-default (typed formae.SecretValue),
    // so the agent hashes it at rest. The conformance runner (v0.2.6+) then
    // verifies the actual hashed envelope against this plaintext by SHA-256
    // digest. Left unwrapped so the discovery test's direct out-of-band create
    // (which bypasses the agent's opaque unwrapping) still sends a JSON string.
    data = "formae-plugin-sdk-test-payload"
  }
}
