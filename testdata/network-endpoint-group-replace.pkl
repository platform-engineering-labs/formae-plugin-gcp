amends "@formae/forma.pkl"

import "@gcp/compute/networkEndpointGroup.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  // Serverless NEG pointing at a Cloud Run service by name. The service name
  // is resolved when a load balancer attaches the NEG, so the service need not
  // exist for the NEG's own create/read/delete lifecycle.
  new networkEndpointGroup.NetworkEndpointGroup {
    label = "plugin-sdk-test-neg"
    // The name is immutable, so changing it forces a replace rather than
    // an update: the old resource is destroyed and a new one takes its place.
    name = "formae-plugin-sdk-test-neg-r2-\(v.testRunID)"
    description = "Test serverless NEG for plugin SDK conformance tests"
    networkEndpointType = "SERVERLESS"
    region = v.gcpRegion
    cloudRun = new networkEndpointGroup.CloudRun {
      service = "formae-plugin-sdk-test-svc-\(v.testRunID)"
    }
  }
}
