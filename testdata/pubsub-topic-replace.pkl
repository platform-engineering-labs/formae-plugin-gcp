amends "@formae/forma.pkl"

import "@gcp/pubsub/topic.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new topic.Topic {
    label = "plugin-sdk-test-pubsub-topic"
    // A topic name is immutable, so changing it forces a replace.
    name = "formae-test-topic2-\(v.testRunID)"
    labels = new Mapping {
      ["environment"] = "test"
      ["managed-by"] = "formae"
    }
  }
}
