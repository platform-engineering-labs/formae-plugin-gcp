amends "@formae/forma.pkl"

import "@gcp/bigtable/instance_bigtable.pkl" as instance
import "@gcp/bigtable/table.pkl" as table
import "@gcp/bigtable/materialized_view.pkl" as materializedView
import "./config/vars.pkl" as v

// A materialized view is defined by a GoogleSQL query over the instance's data,
// so the instance and the table the query reads both come first. DEVELOPMENT is
// the cheap single-node instance type the other Bigtable cases use.
local inst = new instance.Instance {
  label = "plugin-sdk-test-mv-instance"
  project = v.gcpProject
  name = "formae-test-instance-mv-\(v.testRunID)"
  // Bigtable caps displayName at 30 characters.
  displayName = "Plugin SDK MV instance"
  type = "DEVELOPMENT"
  clusters = new Mapping {
    ["cluster1"] = new instance.ClusterConfig {
      location = "\(v.gcpRegion)-a"
      defaultStorageType = "SSD"
    }
  }
}

// The query has to name the table as plain text: interpolating a resolvable
// into a string emits its serialized form, and the API answered
// "Table not found: <base64 of the resolvable>". The name is declared once and
// used in both places instead.
local tblName = "formae_test_mv_table_\(v.testRunID)"

local tbl = new table.Table {
  label = "plugin-sdk-test-mv-table"
  project = v.gcpProject
  instance = inst.res.name
  name = tblName
  columnFamilies = new Mapping {
    ["cf1"] = new table.ColumnFamily {
      name = "cf1"
      gcRule = new table.GCRule {
        maxNumVersions = 1
      }
    }
  }
}

forma {
  v.stack
  v.target

  inst
  tbl

  new materializedView.MaterializedView {
    label = "plugin-sdk-test-bigtable-materialized-view"
    project = v.gcpProject
    // The instance is read off the table rather than the instance itself: it
    // carries the same value, and it is the only resolvable reference the view
    // can make to the table, which the query needs to exist first. Naming the
    // table in the query text creates no ordering edge.
    instance = tbl.res.instance
    name = "formae_test_mv_\(v.testRunID)"
    query = "SELECT _key, cf1 FROM `\(tblName)`"
  }
}
