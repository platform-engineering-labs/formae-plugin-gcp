amends "@formae/forma.pkl"

import "@gcp/bigtable/instance_bigtable.pkl" as instance
import "@gcp/bigtable/table.pkl" as table
import "@gcp/bigtable/materialized_view.pkl" as materializedView
import "./config/vars.pkl" as v

// A materialized view precomputes a SQL query over a table, so both have to
// exist first. Unlike a logical view its query is fixed at creation.
local inst = new instance.Instance {
  label = "plugin-sdk-test-btmv-instance"
  project = v.gcpProject
  name = "formae-test-btmv-\(v.testRunID)"
  displayName = "Plugin SDK MV Host"
  type = "DEVELOPMENT"
  clusters = new Mapping {
    ["cluster1"] = new instance.ClusterConfig {
      location = "\(v.gcpRegion)-a"
      defaultStorageType = "SSD"
    }
  }
}

local tbl = new table.Table {
  label = "plugin-sdk-test-btmv-table"
  project = v.gcpProject
  instance = inst.res.name
  name = "formae-test-btmv-table-\(v.testRunID)"
  // A view's query reads a column family, so the table needs one.
  columnFamilies = new Mapping {
    ["cf"] = new table.ColumnFamily {
      name = "cf"
    }
  }
}

forma {
  v.stack
  v.target

  inst
  tbl

  new materializedView.MaterializedView {
    label = "plugin-sdk-test-bigtable-materialized-view"
    name = "formae-test-btmv-view-\(v.testRunID)"
    instance = inst.res.name
    query = "SELECT _key FROM `formae-test-btmv-table-\(v.testRunID)`"
  }
}
