amends "@formae/forma.pkl"

import "@gcp/iam/serviceAccount.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  // accountId caps at 30 chars, and "formae-plugin-sdk-test-" alone is 23 -
  // no room for the run ID. This is one of the documented exceptions to the
  // long prefix; see scripts/ci/sweep-patterns.sh.
  new serviceAccount.ServiceAccount {
    label = "plugin-sdk-test-service-account"
    name = "formae-test-sa-\(v.testRunID)"
    displayName = "Formae SDK Test Service Account"
    description = "Test service account for plugin SDK conformance tests"
  }
}
