amends "@formae/forma.pkl"

import "@gcp/servicedirectory/namespace.pkl"
import "@gcp/servicedirectory/serviceDirectoryService.pkl" as service
import "./config/vars.pkl" as v

// A service lives inside a namespace, so the namespace comes first.
local ns = new namespace.Namespace {
  label = "plugin-sdk-test-sd-svc-namespace"
  project = v.gcpProject
  name = "formae-plugin-sdk-test-sd-sns-\(v.testRunID)"
}

forma {
  v.stack
  v.target

  ns

  new service.Service {
    label = "plugin-sdk-test-sd-service"
    project = v.gcpProject
    // Resolvable -> the namespace exists before the service is created in it.
    namespace = ns.res.name
    name = "formae-plugin-sdk-test-sd-svc-\(v.testRunID)"
    annotations = new Mapping {
      ["purpose"] = "conformance"
      ["updated"] = "true"
    }
  }
}
