amends "@formae/forma.pkl"

import "@gcp/networkservices/mesh.pkl"
import "./config/vars.pkl" as v

// A mesh is the routing scope of a Cloud Service Mesh: routes attach to it and
// sidecars ask it for their configuration. It is free to hold because it
// allocates nothing at all - no proxy, no address, no capacity. Billing starts
// with the workloads that join a mesh, and nothing joins this one.
forma {
  v.stack
  v.target

  new mesh.Mesh {
    label = "plugin-sdk-test-ns-mesh"
    name = "formae-test-ns-mesh-\(v.testRunID)"
    interceptionPort = 15001
    envoyHeaders = "DEBUG_HEADERS"
    description = "Test mesh for plugin SDK conformance tests"
    labels = new Mapping {
      ["environment"] = "test"
    }
  }
}
