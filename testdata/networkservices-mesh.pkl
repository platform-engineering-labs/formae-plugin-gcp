amends "@formae/forma.pkl"

import "@gcp/networkservices/mesh.pkl"
import "./config/vars.pkl" as v

// A mesh is the config root sidecars share; on its own it is an empty routing
// table with nothing pointing at it, which is exactly what makes it a clean
// conformance case - no prerequisites and nothing to tear down behind it.
//
// Free: a mesh provisions no capacity. It is global, so it lands under
// locations/global whatever region the target names.
forma {
  v.stack
  v.target

  new mesh.Mesh {
    label = "plugin-sdk-test-ns-mesh"
    name = "formae-test-ns-mesh-\(v.testRunID)"
    description = "Test mesh for plugin SDK conformance tests"
    interceptionPort = 15001
    envoyHeaders = "NONE"
    labels = new Mapping {
      ["environment"] = "test"
    }
  }
}
