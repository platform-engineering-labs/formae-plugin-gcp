amends "@formae/forma.pkl"

import "@gcp/orgpolicy/policy.pkl"
import "./config/vars.pkl" as v

// NOTE: the policy id IS the constraint name, and there is exactly one policy
// per constraint per project, so the name canNOT carry the testRunID suffix.
// "iam.disableServiceAccountKeyCreation" is a boolean org-policy constraint that
// is safe to toggle for the brief CRUD window (create -> read -> delete).
forma {
  v.stack
  v.target

  new policy.Policy {
    label = "plugin-sdk-test-orgpolicy"
    name = "iam.disableServiceAccountKeyCreation"
    spec = new policy.PolicySpec {
      rules = new Listing {
        new policy.PolicyRule {
          enforce = true
        }
      }
    }
  }
}
