amends "@formae/forma.pkl"

import "@gcp/compute/network.pkl"
import "@gcp/compute/regionNetworkFirewallPolicy.pkl"
import "@gcp/compute/regionNetworkFirewallPolicyAssociation.pkl"
import "./config/vars.pkl" as v

// Regional policy + network + the association that binds them. The network is
// global; only the policy is regional.
local net = new network.Network {
  label = "plugin-sdk-test-rnfpa-network"
  name = "formae-plugin-sdk-test-rnfpa-net-\(v.testRunID)"
  description = "Network the firewall policy is attached to"
  autoCreateSubnetworks = false
}

local policy = new regionNetworkFirewallPolicy.RegionNetworkFirewallPolicy {
  label = "plugin-sdk-test-rnfpa-policy"
  name = "formae-plugin-sdk-test-rnfpa-pol-\(v.testRunID)"
  description = "Regional policy attached to the network under test"
  region = v.gcpRegion
}

forma {
  v.stack
  v.target

  net
  policy

  new regionNetworkFirewallPolicyAssociation.RegionNetworkFirewallPolicyAssociation {
    label = "plugin-sdk-test-region-network-firewall-policy-association"
    name = "formae-plugin-sdk-test-rnfpa-assoc-\(v.testRunID)"
    // Resolvables -> both the policy and the network exist before the attach verb.
    firewallPolicy = policy.res.name
    region = v.gcpRegion
    attachmentTarget = net.res.selfLink
  }
}
