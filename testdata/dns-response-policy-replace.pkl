amends "@formae/forma.pkl"

import "@gcp/dns/responsePolicy.pkl"
import "./config/vars.pkl" as v

// No network prerequisite: a response policy may attach to networks but does
// not have to, and every fixture that builds one competes for a project-wide
// cap of 30 networks that a full matrix already runs up against. dns-policy
// keeps its network so the reference is still covered somewhere.

forma {
  v.stack
  v.target

  new responsePolicy.ResponsePolicy {
    label = "plugin-sdk-test-dns-response-policy"
    project = v.gcpProject
    // The id field is responsePolicyName, not name.
    // The id is immutable, so changing it forces a replace rather than an
    // update: the old policy is destroyed and a new one takes its place.
    responsePolicyName = "formae-plugin-sdk-test-dnsrp-r2-\(v.testRunID)"
    description = "Plugin SDK conformance response policy"
  }
}
