amends "@formae/forma.pkl"

import "@gcp/dns/responsePolicy.pkl" as responsePolicy
import "./config/vars.pkl" as v

// The replace companion of dns-response-policy. Identical to it but for the id,
// which is immutable: changing it plans a destroy and a create rather than an
// update, and the case asserts the native ID changed.
forma {
  v.stack
  v.target

  new responsePolicy.ResponsePolicy {
    label = "plugin-sdk-test-dns-response-policy"
    name = "formae-test-dns-rp2-\(v.testRunID)"
    description = "Test response policy for plugin SDK conformance tests"
  }
}
