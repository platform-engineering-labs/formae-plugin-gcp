amends "@formae/forma.pkl"

import "@gcp/dataform/repository_dataform.pkl" as repository
import "@gcp/dataform/workspace.pkl"
import "./config/vars.pkl" as v

// A workspace is an editable checkout of a repository, so it needs the
// repository above it. Both are free: the repository has no Git remote, and a
// workspace is metadata and an empty file tree - it compiles nothing and runs
// nothing.
//
// The repository is referenced through its resolvable, which is what orders
// both halves of the lifecycle. On create the repository comes first; on
// destroy the workspace goes first - which matters here, because a repository
// that still has nested resources refuses to delete with HTTP 400
// "has nested resources". Interpolating the repository's name into a string
// would carry no edge and the teardown would fail.
local repo = new repository.Repository {
  label = "plugin-sdk-test-df-ws-repository"
  name = "formae-test-df-wsr-\(v.testRunID)"
  displayName = "Repository owning the workspace under test"
}

forma {
  v.stack
  v.target

  repo

  new workspace.Workspace {
    label = "plugin-sdk-test-df-workspace"
    name = "formae-test-df-ws-\(v.testRunID)"
    repository = repo.res.name
    disableMoves = false
  }
}
