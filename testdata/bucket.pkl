amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@gcp/gcp.pkl"

import "@gcp/storage/bucket.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new bucket.Bucket {
    label = "plugin-sdk-test-bucket"
    name = "formae-plugin-sdk-test-\(v.testRunID)"
    location = v.gcpRegion
    storageClass = "STANDARD"
    versioning = new bucket.Versioning {
      enabled = false
    }
    labels = new Mapping {
      ["environment"] = "test"
      ["managed-by"] = "formae"
    }
  }
}
