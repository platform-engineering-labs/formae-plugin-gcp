amends "@formae/forma.pkl"

import "@gcp/bigtable/instance_bigtable.pkl" as instance
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new instance.Instance {
    label = "plugin-sdk-test-bigtable-instance"
    project = v.gcpProject
    // A Bigtable instance id caps at 33 characters, so instances keep the
    // short "formae-test-" prefix - see scripts/ci/sweep-patterns.sh.
    name = "formae-test-instance-\(v.testRunID)"
    displayName = "Plugin SDK Test Instance"
    type = "DEVELOPMENT"
    labels = new Mapping {
      ["environment"] = "test"
      ["managed-by"] = "formae"
    }
    clusters = new Mapping {
      ["cluster1"] = new instance.ClusterConfig {
        location = "\(v.gcpRegion)-a"
        defaultStorageType = "SSD"
      }
    }
  }
}
