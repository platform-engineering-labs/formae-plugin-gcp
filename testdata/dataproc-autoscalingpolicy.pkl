amends "@formae/forma.pkl"

import "@gcp/dataproc/autoscalingPolicy.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new autoscalingPolicy.AutoscalingPolicy {
    label = "plugin-sdk-test-autoscaling-policy"
    name = "formae-asp-\(v.testRunID)"
    basicAlgorithm = new {
      yarnConfig = new {
        scaleUpFactor = 0.5
        scaleDownFactor = 0.5
        gracefulDecommissionTimeout = "1h"
      }
    }
    workerConfig = new {
      maxInstances = 3
    }
  }
}
