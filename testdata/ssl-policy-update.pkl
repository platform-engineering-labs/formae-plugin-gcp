amends "@formae/forma.pkl"

import "@gcp/compute/sslPolicy.pkl"
import "./config/vars.pkl" as v

// Zero-dependency TLS policy. The paired ssl-policy-update.pkl raises
// minTlsVersion, which exercises sslPolicies.patch and therefore the
// fingerprint round-trip (the API rejects a patch without it).
forma {
  v.stack
  v.target

  new sslPolicy.SslPolicy {
    label = "plugin-sdk-test-ssl-policy"
    name = "formae-plugin-sdk-test-sslpol-\(v.testRunID)"
    description = "Updated SSL policy description"
    profile = "MODERN"
    minTlsVersion = "TLS_1_2"
  }
}
