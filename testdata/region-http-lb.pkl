amends "@formae/forma.pkl"

import "@gcp/compute/regionHealthCheck.pkl"
import "@gcp/compute/regionBackendService.pkl"
import "@gcp/compute/regionUrlMap.pkl"
import "@gcp/compute/regionTargetHttpProxy.pkl"
import "./config/vars.pkl" as v

// Regional internal-managed HTTP LB chain. Each upstream resource is referenced
// via its resolvable so formae creates them in dependency order:
// RegionHealthCheck -> RegionBackendService -> RegionUrlMap -> RegionTargetHttpProxy
forma {
  local hc = new regionHealthCheck.RegionHealthCheck {
    label = "plugin-sdk-test-region-hc"
    name = "formae-test-rhc-\(v.testRunID)"
    region = v.gcpRegion
    type = "HTTP"
    checkIntervalSec = 10
    timeoutSec = 5
    healthyThreshold = 2
    unhealthyThreshold = 3
    httpHealthCheck = new regionHealthCheck.HttpHealthCheck {
      port = 80
      requestPath = "/"
      proxyHeader = "NONE"
    }
  }

  local bs = new regionBackendService.RegionBackendService {
    label = "plugin-sdk-test-region-bs"
    name = "formae-test-rbs-\(v.testRunID)"
    region = v.gcpRegion
    loadBalancingScheme = "INTERNAL_MANAGED"
    protocol = "HTTP"
    timeoutSec = 30
    healthChecks = new Listing {
      hc.res.selfLink
    }
  }

  local um = new regionUrlMap.RegionUrlMap {
    label = "plugin-sdk-test-region-um"
    name = "formae-test-rum-\(v.testRunID)"
    region = v.gcpRegion
    defaultService = bs.res.selfLink
  }

  v.stack
  v.target

  hc
  bs
  um

  new regionTargetHttpProxy.RegionTargetHttpProxy {
    label = "plugin-sdk-test-region-thp"
    name = "formae-test-rthp-\(v.testRunID)"
    region = v.gcpRegion
    urlMap = um.res.selfLink
  }
}
