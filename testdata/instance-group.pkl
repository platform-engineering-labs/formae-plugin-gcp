amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@gcp/compute/network.pkl"
import "@gcp/compute/subnetwork.pkl"
import "@gcp/compute/disk.pkl"
import "@gcp/compute/instance.pkl"
import "@gcp/compute/instanceGroup.pkl"
import "./config/vars.pkl" as v

// Self-contained instance-group membership test. Creates a VM (with its own
// net/subnet/boot-disk, mirroring instance.pkl) and an unmanaged zonal group
// that lists the VM as a member with a named port. This exercises
// create-then-attach (instanceGroups.insert + addInstances) and the
// listInstances read-back. The paired instance-group-update.pkl then removes
// the member and changes the named port to exercise removeInstances +
// setNamedPorts (NativeID must stay stable — update, not replace).
local net = new network.Network {
  label = "plugin-sdk-test-ig-net"
  name = "formae-test-ig-net-\(v.testRunID)"
  autoCreateSubnetworks = false
}
local subnet = new subnetwork.Subnetwork {
  label = "plugin-sdk-test-ig-subnet"
  name = "formae-test-ig-subnet-\(v.testRunID)"
  network = net.res.selfLink
  region = v.gcpRegion
  ipCidrRange = "10.91.0.0/24"
}

forma {
  local bootDisk = new disk.Disk {
    label = "plugin-sdk-test-ig-bootdisk"
    project = v.gcpProject
    zone = v.gcpZone
    name = "formae-test-ig-disk-\(v.testRunID)"
    description = "Boot disk for instance-group member VM"
    sizeGb = 10
    type = "pd-standard"
    sourceImage = formae.value("projects/debian-cloud/global/images/family/debian-12")
  }

  local memberVm = new instance.Instance {
    label = "plugin-sdk-test-ig-vm"
    project = v.gcpProject
    zone = v.gcpZone
    name = "formae-test-ig-vm-\(v.testRunID)"
    machineType = "e2-micro"
    description = "Member VM for instance-group conformance test"
    disks = new Listing {
      new instance.AttachedDisk {
        boot = true
        autoDelete = false
        source = bootDisk.res.selfLink
      }
    }
    // Internal IP only (external-IP org policy).
    networkInterfaces = new Listing {
      new instance.NetworkInterface {
        network = net.res.selfLink
        subnetwork = subnet.res.selfLink
      }
    }
  }

  v.stack
  v.target

  net
  subnet
  bootDisk
  memberVm

  new instanceGroup.InstanceGroup {
    label = "plugin-sdk-test-instance-group"
    name = "formae-test-ig-\(v.testRunID)"
    description = "Test unmanaged instance group with a VM member"
    zone = v.gcpZone
    namedPorts = new Listing {
      new instanceGroup.NamedPort {
        name = "http"
        port = 80
      }
    }
    // Resolvable reference -> establishes VM-before-group-attach ordering and
    // round-trips against the API's returned full self-link URL (PLA-265).
    instances = new Listing {
      memberVm.res.selfLink
    }
  }
}
