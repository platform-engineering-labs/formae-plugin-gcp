amends "@formae/forma.pkl"

import "@gcp/networksecurity/gatewaySecurityPolicy.pkl"
import "./config/vars.pkl" as v

// The container for Secure Web Proxy rules. Free, and it inspects nothing: a
// policy with no rules matches nothing, and nothing is proxied until a Secure
// Web Proxy gateway names the policy.
//
// Regional, unlike most of this API - it lives under the target's region, and
// locations/global is rejected as a malformed name.
//
// tlsInspectionPolicy is left unset. GCP reports it back as an empty string
// anyway, which the plugin strips so the omission survives the round trip.
forma {
  v.stack
  v.target

  new gatewaySecurityPolicy.GatewaySecurityPolicy {
    label = "plugin-sdk-test-ns-gateway-security-policy"
    name = "formae-test-ns-gsp-\(v.testRunID)"
    description = "Test gateway security policy for plugin SDK conformance tests"
  }
}
