amends "@formae/forma.pkl"

import "@gcp/compute/sslCertificate.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  // Managed certificate. The resource is created immediately; Google-managed
  // issuance for the domain is a separate async step (not required for the
  // create/read/delete lifecycle this test exercises).
  new sslCertificate.SslCertificate {
    label = "plugin-sdk-test-ssl-cert"
    name = "formae-plugin-sdk-test-cert-\(v.testRunID)"
    description = "Test managed SSL certificate for plugin SDK conformance tests"
    type = "MANAGED"
    managed = new sslCertificate.Managed {
      domains = new Listing {
        "formae-\(v.testRunID).example.com"
      }
    }
  }
}
