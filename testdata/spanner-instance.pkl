amends "@formae/forma.pkl"

import "@gcp/spanner/spannerInstance.pkl" as spannerInstance
import "./config/vars.pkl" as v

// Unlike the rest of these fixtures, a Spanner instance is billed for as long
// as it exists. 100 processing units is the smallest instance the API accepts -
// a tenth of a node - which is why it is what this case asks for.
forma {
  v.stack
  v.target

  new spannerInstance.Instance {
    label = "plugin-sdk-test-spanner-instance"
    project = v.gcpProject
    name = "formae-plugin-sdk-test-spi-\(v.testRunID)"
    // The regional config matching the target keeps the data in one region.
    config = "regional-\(v.gcpRegion)"
    displayName = "Plugin SDK conformance"
    processingUnits = 100
  }
}
