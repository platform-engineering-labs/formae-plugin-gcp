amends "@formae/forma.pkl"

import "@gcp/spanner/spannerInstance.pkl" as instance
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new instance.Instance {
    label = "plugin-sdk-test-spanner-instance"
    name = "formae-test-\(v.testRunID)"
    config = "projects/development-477117/instanceConfigs/regional-us-central1"
    displayName = "Plugin SDK Test Spanner Instance"
    processingUnits = 100
  }
}
