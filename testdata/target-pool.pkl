amends "@formae/forma.pkl"

import "@gcp/compute/targetPool.pkl"
import "./config/vars.pkl" as v

// A target pool with no members and no health check. It is the legacy
// network-load-balancer target, it stands entirely on its own, and it costs
// nothing - which makes it the cheapest way to prove the type works.
forma {
  v.stack
  v.target

  new targetPool.TargetPool {
    label = "plugin-sdk-test-target-pool"
    name = "formae-test-tp-\(v.testRunID)"
    description = "Test target pool for plugin SDK conformance tests"
    region = v.gcpRegion
    sessionAffinity = "NONE"
  }
}
