amends "@formae/forma.pkl"

import "@gcp/alloydb/alloydbCluster.pkl"
import "@gcp/alloydb/alloydbInstance.pkl"
import "@gcp/alloydb/alloydbUser.pkl"
import "@formae/formae.pkl"
import "./config/vars.pkl" as v

// Cluster + PRIMARY instance + a database user. A user needs a serving
// instance, so the whole chain is built — which makes this one of the slowest
// cases in the suite. The cluster reuses the same default-network
// setup as alloydb-cluster.pkl (the project's default VPC already has a private
// service access range, which AlloyDB requires).
//
// ZONAL and the smallest supported machine (2 vCPU) keep the create as short
// and cheap as this resource allows — an AlloyDB instance still takes several
// minutes, so this case needs a raised TIMEOUT.
local dbCluster = new alloydbCluster.Cluster {
  label = "plugin-sdk-test-alloydb-user-cluster"
  name = "formae-test-user-cluster-\(v.testRunID)"
  networkConfig = new {
    network = "projects/\(v.gcpProject)/global/networks/default"
  }
  displayName = "Formae AlloyDB user-test cluster"
}

forma {
  v.stack
  v.target

  dbCluster

  local primary = new alloydbInstance.Instance {
    label = "plugin-sdk-test-alloydb-user-instance"
    name = "formae-test-user-instance-\(v.testRunID)"
    // Resolvable -> establishes cluster-before-instance create ordering.
    cluster = dbCluster.res.name
    instanceType = "PRIMARY"
    displayName = "Formae AlloyDB conformance test instance"
    availabilityType = "ZONAL"
    machineConfig = new alloydbInstance.MachineConfig {
      cpuCount = 2
    }
  }

  primary

  new alloydbUser.User {
    label = "plugin-sdk-test-alloydb-user"
    name = "formae-test-user-\(v.testRunID)"
    // Referenced through the instance, not the cluster: AlloyDB refuses to
    // create a user until a primary instance is serving, and the instance's
    // resolvable yields the same cluster id while ordering the user after it.
    cluster = primary.res.cluster
    userType = "ALLOYDB_BUILT_IN"
    password = formae.value("Formae-Conformance-Pw-1").opaque
    databaseRoles = new Listing {
      "alloydbsuperuser"
    }
  }
}
