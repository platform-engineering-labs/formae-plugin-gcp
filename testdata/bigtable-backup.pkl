amends "@formae/forma.pkl"

import "@gcp/bigtable/instance_bigtable.pkl" as instance
import "@gcp/bigtable/table.pkl" as btTable
import "@gcp/bigtable/backup.pkl" as backup
import "./config/vars.pkl" as v

// Backups require a PRODUCTION instance (DEVELOPMENT does not support backups)
// and live in a cluster, taken from an existing table.
local instanceName = "formae-test-bkp-inst-\(v.testRunID)"
local tableName = "formae-test-bkp-table-\(v.testRunID)"

forma {
  v.stack
  v.target

  new instance.Instance {
    label = "plugin-sdk-test-backup-instance"
    project = v.gcpProject
    name = instanceName
    displayName = "Plugin SDK Backup Test Instance"
    type = "PRODUCTION"
    clusters = new Mapping {
      ["cluster1"] = new instance.ClusterConfig {
        location = "\(v.gcpRegion)-a"
        defaultStorageType = "SSD"
        serveNodes = 1
      }
    }
  }

  new btTable.Table {
    label = "plugin-sdk-test-backup-table"
    project = v.gcpProject
    instance = instanceName
    name = tableName
    columnFamilies = new Mapping {
      ["cf1"] = new btTable.ColumnFamily {
        name = "cf1"
      }
    }
  }

  new backup.Backup {
    label = "plugin-sdk-test-backup"
    project = v.gcpProject
    instance = instanceName
    cluster = "cluster1"
    name = "formae-test-backup-\(v.testRunID)"
    sourceTable = "projects/\(v.gcpProject)/instances/\(instanceName)/tables/\(tableName)"
    expireTime = "2030-01-01T00:00:00Z"
  }
}
