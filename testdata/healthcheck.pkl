amends "@formae/forma.pkl"

import "@gcp/compute/healthCheck.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new healthCheck.HealthCheck {
    label = "plugin-sdk-test-healthcheck"
    name = "formae-test-hc-\(v.testRunID)"
    description = "Test health check for plugin SDK conformance tests"
    type = "TCP"
    checkIntervalSec = 10
    timeoutSec = 5
    healthyThreshold = 2
    unhealthyThreshold = 3
    tcpHealthCheck = new healthCheck.TcpHealthCheck {
      port = 80
      proxyHeader = "NONE"
    }
  }
}
