amends "@formae/forma.pkl"

import "@gcp/certificateauthority/caPool.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new caPool.CaPool {
    label = "plugin-sdk-test-capool"
    name = "formae-test-pool-\(v.testRunID)"
    tier = "ENTERPRISE"
  }
}
