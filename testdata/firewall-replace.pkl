amends "@formae/forma.pkl"

import "@gcp/compute/network.pkl"
import "@gcp/compute/firewall.pkl"
import "./config/vars.pkl" as v

local testNetworkName = "formae-plugin-sdk-test-fw-net-\(v.testRunID)"

// Parent network for the firewall. Referenced via its resolvable self-link
// rather than a literal path, for two reasons: the reference is what orders the
// firewall after the network on create and before it on destroy (GCP refuses to
// delete a network that still has a firewall attached), and the self-link is the
// form the API returns on read, so an unchanged forma re-applies as a zero-op
// (PLA-265, PLA-251).
local net = new network.Network {
  label = "plugin-sdk-test-network-for-firewall"
  name = testNetworkName
  description = "Test network for firewall conformance test"
  autoCreateSubnetworks = false
  routingConfig = new network.RoutingConfig {
    routingMode = "REGIONAL"
  }
}

forma {
  v.stack
  v.target

  net

  // Test firewall rule - allow SSH
  new firewall.Firewall {
    label = "plugin-sdk-test-firewall"
    // The name is immutable, so changing it forces a replace rather than
    // an update: the old resource is destroyed and a new one takes its place.
    name = "formae-plugin-sdk-test-fw-r2-\(v.testRunID)"
    description = "Test firewall for plugin SDK conformance tests"
    network = net.res.selfLink
    direction = "INGRESS"
    priority = 1000
    sourceRanges = new Listing {
      "10.0.0.0/8"
    }
    allowed = new Listing {
      new firewall.Rule {
        protocol = "tcp"
        ports = new Listing {
          "22"
          "80"
          "443"
        }
      }
      new firewall.Rule {
        protocol = "icmp"
        ports = new Listing {}
      }
    }
    targetTags = new Listing {
      "test-server"
    }
  }
}
