amends "@formae/forma.pkl"

import "@gcp/bigquery/dataset.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new dataset.Dataset {
    label = "plugin-sdk-test-dataset"
    project = v.gcpProject
    datasetId = "formae_test_\(v.testRunID)"           // Same (createOnly identifier)
    location = v.gcpRegion                                        // Same (createOnly)
    name = "Plugin SDK Test Dataset (updated)"                    // Changed (mutable)
    description = "Updated dataset for plugin SDK conformance tests"  // Changed (mutable)
    labels = new Mapping {
      ["environment"] = "production"   // Changed (mutable)
      ["managed-by"] = "formae"
    }
  }
}
