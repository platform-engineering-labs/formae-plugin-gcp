amends "@formae/forma.pkl"

import "@gcp/logging/savedQuery.pkl"
import "./config/vars.pkl" as v

// Zero-dependency saved Logs Explorer query.
//
// The location follows the target rather than being pinned to "global": saved
// queries are supported in either, and discovery lists with no properties to
// declare a location with, so it looks in the target's location. A query pinned
// to global is created and managed correctly but can never be discovered.
forma {
  v.stack
  v.target

  new savedQuery.SavedQuery {
    label = "plugin-sdk-test-logging-saved-query"
    // The name is immutable, so changing it forces a replace rather than
    // an update: the old resource is destroyed and a new one takes its place.
    name = "formae-test-sq-r2-\(v.testRunID)"
    location = v.gcpLocation
    displayName = "Formae conformance error query"
    description = "Test saved query for plugin SDK conformance tests"
    visibility = "SHARED"
    loggingQuery = new savedQuery.LoggingQuery {
      filter = "severity>=\"ERROR\""
    }
  }
}
