amends "@formae/forma.pkl"

import "@gcp/compute/network.pkl"
import "@gcp/compute/subnetwork.pkl"
import "@gcp/compute/instanceTemplate.pkl"
import "@gcp/compute/instanceGroupManager.pkl"
import "@gcp/compute/autoscaler.pkl"
import "./config/vars.pkl" as v

// Full autoscaling chain: net + subnet + template + MIG + autoscaler.
// The MIG declares targetSize = 0 and the autoscaler minNumReplicas = 0 so no
// VM boots — the test project has no Cloud NAT and forbids external IPs, so a
// VM could never pull its image. The autoscaler object is what is under test.
local net = new network.Network {
  label = "plugin-sdk-test-as-net"
  name = "formae-test-as-net-\(v.testRunID)"
  autoCreateSubnetworks = false
}
local subnet = new subnetwork.Subnetwork {
  label = "plugin-sdk-test-as-subnet"
  name = "formae-test-as-subnet-\(v.testRunID)"
  network = net.res.selfLink
  region = v.gcpRegion
  ipCidrRange = "10.93.0.0/24"
}
local tmpl = new instanceTemplate.InstanceTemplate {
  label = "plugin-sdk-test-as-template"
  name = "formae-test-as-tmpl-\(v.testRunID)"
  description = "Blueprint for the autoscaler conformance test"
  properties = new instanceTemplate.InstanceProperties {
    machineType = "e2-micro"
    disks = new Listing {
      new instanceTemplate.TemplateAttachedDisk {
        boot = true
        autoDelete = true
        initializeParams = new instanceTemplate.TemplateDiskInitializeParams {
          sourceImage = "projects/debian-cloud/global/images/family/debian-12"
        }
      }
    }
    networkInterfaces = new Listing {
      new instanceTemplate.TemplateNetworkInterface {
        network = net.res.selfLink
        subnetwork = subnet.res.selfLink
      }
    }
  }
}
local mig = new instanceGroupManager.InstanceGroupManager {
  label = "plugin-sdk-test-as-mig"
  name = "formae-test-as-mig-\(v.testRunID)"
  description = "MIG the autoscaler scales"
  zone = v.gcpZone
  baseInstanceName = "formae-test-as-vm"
  instanceTemplate = tmpl.res.selfLink
  targetSize = 0
}

forma {
  v.stack
  v.target

  net
  subnet
  tmpl
  mig

  new autoscaler.Autoscaler {
    label = "plugin-sdk-test-autoscaler"
    name = "formae-test-as-\(v.testRunID)"
    description = "Test autoscaler for plugin SDK conformance tests"
    zone = v.gcpZone
    // Resolvable -> establishes MIG-before-autoscaler create ordering.
    instanceGroupManager = mig.res.selfLink
    autoscalingPolicy = new autoscaler.AutoscalingPolicy {
      maxNumReplicas = 2
      minNumReplicas = 0
      cpuUtilization = new autoscaler.CpuUtilization {
        utilizationTarget = 0.6
      }
    }
  }
}
