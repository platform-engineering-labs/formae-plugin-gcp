amends "@formae/forma.pkl"

import "@gcp/servicedirectory/namespace.pkl"
import "@gcp/servicedirectory/service_servicedirectory.pkl" as service
import "./config/vars.pkl" as v

// The replace companion of servicedirectory-service. The namespace is the
// prerequisite and does not move; the service id does, and it is immutable, so
// the plan is a destroy and a create rather than an update.
local ns = new namespace.Namespace {
  label = "plugin-sdk-test-sd-svc-namespace"
  name = "formae-test-sd-svc-ns-\(v.testRunID)"
}

forma {
  v.stack
  v.target

  ns

  new service.Service {
    label = "plugin-sdk-test-sd-service"
    name = "formae-test-sd-svc2-\(v.testRunID)"
    namespace = ns.res.name
    annotations = new Mapping {
      ["environment"] = "test"
    }
  }
}
