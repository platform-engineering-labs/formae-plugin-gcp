amends "@formae/forma.pkl"

import "@gcp/dns/dnsPolicy.pkl" as dnsPolicy
import "./config/vars.pkl" as v

// The replace companion of dns-policy. Identical to it but for the id, which is
// immutable: changing it plans a destroy and a create rather than an update, and
// the case asserts the native ID changed.
forma {
  v.stack
  v.target

  new dnsPolicy.Policy {
    label = "plugin-sdk-test-dns-policy"
    name = "formae-test-dns-policy2-\(v.testRunID)"
    description = "Test DNS policy for plugin SDK conformance tests"
    enableInboundForwarding = false
    enableLogging = false
  }
}
