amends "@formae/forma.pkl"

import "@gcp/logging/logMetric.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new logMetric.LogMetric {
    label = "plugin-sdk-test-log-metric"
    // The name is immutable, so changing it forces a replace rather than
    // an update: the old resource is destroyed and a new one takes its place.
    name = "formae_test_metric_r2_\(v.testRunID)"
    filter = "resource.type=\"gce_instance\""
    description = "Test log-based metric for plugin SDK conformance tests"
  }
}
