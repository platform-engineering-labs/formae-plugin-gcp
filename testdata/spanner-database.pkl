amends "@formae/forma.pkl"

import "@gcp/spanner/instance_spanner.pkl" as instance
import "@gcp/spanner/database_spanner.pkl" as database
import "./config/vars.pkl" as v

// The instance the database lives on. Referenced through its resolvable so
// formae creates and settles the instance first. A Spanner database id is
// capped at 30 characters, hence the shorter prefix here.
local inst = new instance.Instance {
  label = "plugin-sdk-test-spanner-db-instance"
  name = "formae-test-spdb-inst-\(v.testRunID)"
  config = "regional-\(v.gcpRegion)"
  displayName = "Formae db host"
  processingUnits = 100
}

forma {
  v.stack
  v.target

  inst

  new database.Database {
    label = "plugin-sdk-test-spanner-database"
    name = "formae-test-sp-db-\(v.testRunID)"
    instance = inst.res.name
  }
}
