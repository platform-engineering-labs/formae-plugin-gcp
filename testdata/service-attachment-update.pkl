amends "@formae/forma.pkl"

import "@gcp/compute/network.pkl"
import "@gcp/compute/subnetwork.pkl"
import "@gcp/compute/regionHealthCheck.pkl"
import "@gcp/compute/regionBackendService.pkl"
import "@gcp/compute/forwardingRule.pkl"
import "@gcp/compute/serviceAttachment.pkl"
import "./config/vars.pkl" as v

// Producer-side Private Service Connect: an internal TCP load balancer, plus a
// PRIVATE_SERVICE_CONNECT subnet for consumer NAT, published as a service
// attachment. Every reference is a resolvable self-link so formae orders the
// creates and the stored full URLs round-trip:
//
//   network -> subnet + psc subnet
//           -> RegionHealthCheck -> RegionBackendService -> ForwardingRule
//           -> ServiceAttachment
//
// The backend service has no backends: the attachment only needs the LB to
// exist, and adding instance groups would mean booting VMs that cannot reach
// the internet in this project.
local net = new network.Network {
  label = "plugin-sdk-test-sa-net"
  name = "formae-plugin-sdk-test-sa-net-\(v.testRunID)"
  autoCreateSubnetworks = false
}
local subnet = new subnetwork.Subnetwork {
  label = "plugin-sdk-test-sa-subnet"
  name = "formae-plugin-sdk-test-sa-subnet-\(v.testRunID)"
  network = net.res.selfLink
  region = v.gcpRegion
  ipCidrRange = "10.98.0.0/24"
}
// Consumer traffic is NATed through this subnet; PSC requires the dedicated
// purpose, and such a subnet carries no instances.
local pscSubnet = new subnetwork.Subnetwork {
  label = "plugin-sdk-test-sa-psc-subnet"
  name = "formae-plugin-sdk-test-sa-psc-\(v.testRunID)"
  network = net.res.selfLink
  region = v.gcpRegion
  ipCidrRange = "10.98.1.0/24"
  purpose = "PRIVATE_SERVICE_CONNECT"
}
local hc = new regionHealthCheck.RegionHealthCheck {
  label = "plugin-sdk-test-sa-hc"
  name = "formae-plugin-sdk-test-sa-hc-\(v.testRunID)"
  region = v.gcpRegion
  type = "TCP"
  tcpHealthCheck = new regionHealthCheck.TcpHealthCheck {
    port = 80
  }
}
local bes = new regionBackendService.RegionBackendService {
  label = "plugin-sdk-test-sa-bes"
  name = "formae-plugin-sdk-test-sa-bes-\(v.testRunID)"
  region = v.gcpRegion
  loadBalancingScheme = "INTERNAL"
  protocol = "TCP"
  healthChecks = new Listing {
    hc.res.selfLink
  }
}
local rule = new forwardingRule.ForwardingRule {
  label = "plugin-sdk-test-sa-rule"
  name = "formae-plugin-sdk-test-sa-rule-\(v.testRunID)"
  region = v.gcpRegion
  loadBalancingScheme = "INTERNAL"
  backendService = bes.res.selfLink
  network = net.res.selfLink
  subnetwork = subnet.res.selfLink
  ports = new Listing {
    "80"
  }
}

forma {
  v.stack
  v.target

  net
  subnet
  pscSubnet
  hc
  bes
  rule

  new serviceAttachment.ServiceAttachment {
    label = "plugin-sdk-test-service-attachment"
    name = "formae-plugin-sdk-test-sa-\(v.testRunID)"
    description = "Updated PSC service attachment description"
    region = v.gcpRegion
    connectionPreference = "ACCEPT_AUTOMATIC"
    enableProxyProtocol = false
    targetService = rule.res.selfLink
    natSubnets = new Listing {
      pscSubnet.res.selfLink
    }
  }
}
