amends "@formae/forma.pkl"

import "@gcp/spanner/instance_spanner.pkl" as instance
import "@gcp/spanner/database_spanner.pkl" as database
import "./config/vars.pkl" as v

// The replace companion of spanner-database. The instance is unchanged - it is
// the prerequisite, not the resource under test - while the database id moves.
// A database id is immutable.
// A Spanner database id caps at 30 characters and "formae-plugin-sdk-test-"
// alone is 23, so the database keeps the short "formae-test-" prefix. The
// instance above it has no such cap and carries the long one.
local inst = new instance.Instance {
  label = "plugin-sdk-test-spanner-db-instance"
  name = "formae-plugin-sdk-test-spdb-inst-\(v.testRunID)"
  config = "regional-\(v.gcpRegion)"
  displayName = "Formae db host"
  processingUnits = 100
}

forma {
  v.stack
  v.target

  inst

  new database.Database {
    label = "plugin-sdk-test-spanner-database"
    name = "formae-test-sp-db2-\(v.testRunID)"
    instance = inst.res.name
  }
}
