amends "@formae/forma.pkl"

import "@gcp/secretmanager/secret.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new secret.Secret {
    label = "plugin-sdk-test-secret"
    // A secret name is immutable, so changing it forces a replace.
    name = "formae-test-secret2-\(v.testRunID)"
    // replication omitted -> provisioner defaults to automatic (Google-managed)
    labels = new Mapping {
      ["environment"] = "test"
      ["managed-by"] = "formae"
    }
  }
}
