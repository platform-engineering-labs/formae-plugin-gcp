amends "@formae/forma.pkl"

import "@gcp/servicedirectory/namespace.pkl"
import "./config/vars.pkl" as v

// A namespace has no prerequisites and costs nothing to hold — Service
// Directory bills lookups, and nothing looks this up.
forma {
  v.stack
  v.target

  new namespace.Namespace {
    label = "plugin-sdk-test-sd-namespace"
    project = v.gcpProject
    // A namespace id is immutable, so changing it is what forces a replace:
    // the old namespace is destroyed and a new one takes its place, which the
    // harness checks by requiring the native ID to change.
    name = "formae-plugin-sdk-test-sd-ns2-\(v.testRunID)"
    labels = new Mapping {
      ["purpose"] = "conformance"
    }
  }
}
