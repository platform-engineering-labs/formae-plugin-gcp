amends "@formae/forma.pkl"

import "@gcp/servicedirectory/namespace.pkl"
import "./config/vars.pkl" as v

// The replace companion of servicedirectory-namespace. Identical to it but for
// the id, which is immutable: changing it plans a destroy and a create rather
// than an update, and the case asserts the native ID changed.
forma {
  v.stack
  v.target

  new namespace.Namespace {
    label = "plugin-sdk-test-sd-namespace"
    name = "formae-test-sd-ns2-\(v.testRunID)"
    labels = new Mapping {
      ["environment"] = "test"
      ["managed-by"] = "formae"
    }
  }
}
