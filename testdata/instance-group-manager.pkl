amends "@formae/forma.pkl"

import "@gcp/compute/network.pkl"
import "@gcp/compute/subnetwork.pkl"
import "@gcp/compute/instanceTemplate.pkl"
import "@gcp/compute/instanceGroupManager.pkl"
import "./config/vars.pkl" as v

// Self-contained MIG test: net + subnet + template + manager.
// targetSize = 0 so the group is created without booting any VM — the test
// project's network has no Cloud NAT and the org policy forbids external IPs,
// so a VM could never pull its image. The MIG object is what is under test.
local net = new network.Network {
  label = "plugin-sdk-test-mig-net"
  name = "formae-test-mig-net-\(v.testRunID)"
  autoCreateSubnetworks = false
}
local subnet = new subnetwork.Subnetwork {
  label = "plugin-sdk-test-mig-subnet"
  name = "formae-test-mig-subnet-\(v.testRunID)"
  network = net.res.selfLink
  region = v.gcpRegion
  ipCidrRange = "10.92.0.0/24"
}
local tmpl = new instanceTemplate.InstanceTemplate {
  label = "plugin-sdk-test-mig-template"
  name = "formae-test-mig-tmpl-\(v.testRunID)"
  description = "Blueprint for the MIG conformance test"
  properties = new instanceTemplate.InstanceProperties {
    machineType = "e2-micro"
    disks = new Listing {
      new instanceTemplate.TemplateAttachedDisk {
        boot = true
        autoDelete = true
        initializeParams = new instanceTemplate.TemplateDiskInitializeParams {
          sourceImage = "projects/debian-cloud/global/images/family/debian-12"
        }
      }
    }
    networkInterfaces = new Listing {
      new instanceTemplate.TemplateNetworkInterface {
        network = net.res.selfLink
        subnetwork = subnet.res.selfLink
      }
    }
  }
}

forma {
  v.stack
  v.target

  net
  subnet
  tmpl

  new instanceGroupManager.InstanceGroupManager {
    label = "plugin-sdk-test-instance-group-manager"
    name = "formae-test-mig-\(v.testRunID)"
    description = "Test managed instance group for plugin SDK conformance tests"
    zone = v.gcpZone
    baseInstanceName = "formae-test-mig-vm"
    // Resolvable -> establishes template-before-MIG create ordering.
    instanceTemplate = tmpl.res.selfLink
    targetSize = 0
  }
}
