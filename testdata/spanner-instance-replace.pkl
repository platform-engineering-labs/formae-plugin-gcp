amends "@formae/forma.pkl"

import "@gcp/spanner/instance_spanner.pkl" as instance
import "./config/vars.pkl" as v

// The replace companion of spanner-instance. Identical to it but for the id,
// which is immutable: changing it plans a destroy and a create rather than an
// update, and the case asserts the native ID changed. Still 100 processing
// units, the floor, because a Spanner instance is billed while it exists.
forma {
  v.stack
  v.target

  new instance.Instance {
    label = "plugin-sdk-test-spanner-instance"
    name = "formae-test-spanner2-\(v.testRunID)"
    config = "regional-\(v.gcpRegion)"
    displayName = "Formae conformance"
    processingUnits = 100
    labels = new Mapping {
      ["environment"] = "test"
      ["managed-by"] = "formae"
    }
  }
}
