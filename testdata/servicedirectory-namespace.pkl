amends "@formae/forma.pkl"

import "@gcp/servicedirectory/namespace.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new namespace.Namespace {
    label = "plugin-sdk-test-servicedirectory-namespace"
    name = "formae-test-ns-\(v.testRunID)"
    labels {
      ["managed-by"] = "formae"
    }
  }
}
