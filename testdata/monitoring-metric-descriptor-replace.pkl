amends "@formae/forma.pkl"

import "@gcp/monitoring/metricDescriptor.pkl"
import "./config/vars.pkl" as v

// A custom metric descriptor. It stands entirely on its own - no time series is
// written against it and nothing is charged for declaring one - which makes it
// the cheapest way to prove the type works.
//
// The type must sit under custom.googleapis.com/, and the run id keeps
// concurrent runs from colliding on it. Slashes are legal in a metric type but
// not in the trailing segment, so the id goes last.
forma {
  v.stack
  v.target

  new metricDescriptor.MetricDescriptor {
    label = "plugin-sdk-test-metric-descriptor"
    // The name is immutable, so changing it forces a replace rather than
    // an update. The prerequisites above are untouched: only the resource
    // under test is replaced.
    name = "custom.googleapis.com/formae_plugin_sdk_test_r2/\(v.testRunID)"
    metricKind = "GAUGE"
    valueType = "DOUBLE"
    displayName = "formae plugin sdk test metric"
    description = "Test metric descriptor for plugin SDK conformance tests"
    unit = "1"
    // No labels. The API rewrites what it stores for a label - the element it
    // returns does not match the one declared - and the harness compares array
    // elements whole, so a declared label reads as missing. Labels are not
    // needed to prove the type creates, reads, deletes and discovers.
  }
}
