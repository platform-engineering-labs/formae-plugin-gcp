amends "@formae/forma.pkl"

import "@gcp/compute/healthCheck.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new healthCheck.HealthCheck {
    label = "plugin-sdk-test-healthcheck"
    name = "formae-test-hc-\(v.testRunID)"  // Same (createOnly)
    description = "Updated health check for plugin SDK conformance tests"  // Changed
    type = "TCP"                                                           // Same (createOnly)
    checkIntervalSec = 15   // Changed (mutable)
    timeoutSec = 8          // Changed (mutable)
    healthyThreshold = 3    // Changed (mutable)
    unhealthyThreshold = 4  // Changed (mutable)
    tcpHealthCheck = new healthCheck.TcpHealthCheck {
      port = 443            // Changed (mutable)
      proxyHeader = "NONE"
    }
  }
}
