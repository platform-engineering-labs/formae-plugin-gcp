amends "@formae/forma.pkl"

import "@gcp/compute/networkFirewallPolicy.pkl"
import "./config/vars.pkl" as v

// Zero-dependency policy. Rules and network associations are separate API
// operations (addRule / addAssociation) and are not modelled yet, so the policy
// here carries only GCP's implied rules.
forma {
  v.stack
  v.target

  new networkFirewallPolicy.NetworkFirewallPolicy {
    label = "plugin-sdk-test-network-firewall-policy"
    name = "formae-test-nfp-\(v.testRunID)"
    description = "Updated network firewall policy description"
  }
}
