amends "@formae/forma.pkl"

import "@gcp/monitoring/group.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new group.Group {
    label = "plugin-sdk-test-monitoring-group"
    displayName = "formae-test-group-\(v.testRunID)"
    filter = "resource.type = \"gce_instance\""
  }
}
