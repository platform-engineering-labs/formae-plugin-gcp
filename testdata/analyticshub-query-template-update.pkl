amends "@formae/forma.pkl"

import "@gcp/analyticshub/dataExchange.pkl"
import "@gcp/analyticshub/queryTemplate.pkl"
import "./config/vars.pkl" as v

// Query templates only exist inside a data clean room, so the exchange declares
// dcrExchangeConfig rather than the default sharing environment. A default
// exchange rejects them.
local cleanRoom = new dataExchange.DataExchange {
  label = "plugin-sdk-test-ah-clean-room"
  name = "formae_test_cr_\(v.testRunID)"
  location = v.gcpLocation
  displayName = "formae plugin sdk test clean room"
  sharingEnvironmentConfig = new dataExchange.SharingEnvironmentConfig {
    dcrExchangeConfig = new dataExchange.DcrExchangeConfig {}
  }
}

forma {
  v.stack
  v.target

  cleanRoom

  new queryTemplate.QueryTemplate {
    label = "plugin-sdk-test-analyticshub-query-template"
    name = "formae_test_qt_\(v.testRunID)"
    location = v.gcpLocation
    dataExchange = cleanRoom.res.name
    displayName = "formae plugin sdk test query template"
    // The API refuses a template whose primaryContact is not the caller's own
    // email: "Primary contact must be the same as the authenticated user's
    // email." Who that is differs between CI and a local run, so it comes from
    // the environment - run-conformance-case.sh reads it off the credentials
    // the plugin will use. A fixture reading this must run through that script.
    primaryContact = read("env:FORMAE_TEST_CALLER_EMAIL")
    description = "Updated by the formae GCP plugin conformance suite."
    // The definition body is the routine itself, named after the template and
    // WITHOUT a CREATE TABLE FUNCTION prefix - the API parses the leading
    // identifier as the routine name and rejects any other shape with "Query
    // template routine name should be same as the template name."
    routine = new queryTemplate.Routine {
      routineType = "TABLE_VALUED_FUNCTION"
      definitionBody = "formae_test_qt_\(v.testRunID)() AS (SELECT 1 AS n)"
    }
  }
}
