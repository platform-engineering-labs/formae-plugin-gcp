amends "@formae/forma.pkl"

import "@gcp/compute/healthCheck.pkl"
import "@gcp/compute/backendService.pkl"
import "@gcp/compute/targetTcpProxy.pkl"
import "./config/vars.pkl" as v

forma {
  // HealthCheck -> BackendService -> TargetTcpProxy. The TCP proxy references
  // the backend service via its resolvable, so formae creates them
  // producer-first and tears them down consumer-first (proxy -> backend service
  // -> health check) under the default edge — matching GCP referential
  // integrity (the proxy must be deleted before the backend service it points
  // at). Mirrors target-http-proxy.pkl for the TCP proxy variant.
  local hc = new healthCheck.HealthCheck {
    label = "plugin-sdk-test-ttp-healthcheck"
    name = "formae-plugin-sdk-test-ttp-hc-\(v.testRunID)"
    type = "TCP"
    checkIntervalSec = 10
    timeoutSec = 5
    healthyThreshold = 2
    unhealthyThreshold = 3
    tcpHealthCheck = new healthCheck.TcpHealthCheck {
      port = 110
      proxyHeader = "NONE"
    }
  }

  local bs = new backendService.BackendService {
    label = "plugin-sdk-test-ttp-backend-service"
    name = "formae-plugin-sdk-test-ttp-bs-\(v.testRunID)"
    loadBalancingScheme = "EXTERNAL_MANAGED"
    protocol = "TCP"
    timeoutSec = 30
    healthChecks = new Listing {
      hc.res.selfLink
    }
  }

  v.stack
  v.target

  hc
  bs

  new targetTcpProxy.TargetTcpProxy {
    label = "plugin-sdk-test-target-tcp-proxy"
    name = "formae-plugin-sdk-test-ttp-\(v.testRunID)"
    description = "Test target TCP proxy for plugin SDK conformance tests"
    service = bs.res.selfLink
    proxyHeader = "NONE"
  }
}
