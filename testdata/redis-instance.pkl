amends "@formae/forma.pkl"

import "@gcp/redis/redisInstance.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new redisInstance.Instance {
    label = "plugin-sdk-test-redis-instance"
    name = "formae-test-redis-\(v.testRunID)"
    tier = "BASIC"
    memorySizeGb = 1
  }
}
