amends "@formae/forma.pkl"

import "@gcp/monitoring/customService.pkl"
import "./config/vars.pkl" as v

// Standalone service (no SLOs). monitoring-slo.pkl covers the nested case.
forma {
  v.stack
  v.target

  new customService.CustomService {
    label = "plugin-sdk-test-monitoring-custom-service"
    // The name is immutable, so changing it forces a replace rather than
    // an update: the old resource is destroyed and a new one takes its place.
    name = "formae-plugin-sdk-test-cs-r2-\(v.testRunID)"
    displayName = "Formae conformance custom service"
  }
}
