amends "@formae/forma.pkl"

import "@gcp/spanner/instance_spanner.pkl" as instance
import "@gcp/spanner/database_spanner.pkl" as database
import "@gcp/spanner/backupSchedule.pkl" as backupSchedule
import "./config/vars.pkl" as v

// A schedule needs the two collections above it. Both are referenced through
// their resolvables so formae orders the creates.
local inst = new instance.Instance {
  label = "plugin-sdk-test-spanner-bs-instance"
  name = "formae-test-spbs-inst-\(v.testRunID)"
  config = "regional-\(v.gcpRegion)"
  displayName = "Formae schedule host"
  processingUnits = 100
}

local db = new database.Database {
  label = "plugin-sdk-test-spanner-bs-database"
  name = "formae-sp-bs-\(v.testRunID)"
  instance = inst.res.name
}

forma {
  v.stack
  v.target

  inst
  db

  new backupSchedule.BackupSchedule {
    label = "plugin-sdk-test-spanner-backup-schedule"
    name = "formae-test-spanner-bs-\(v.testRunID)"
    instance = inst.res.name
    database = db.res.name
    retentionDuration = "86400s"
    spec = new backupSchedule.BackupScheduleSpec {
      cronSpec = new backupSchedule.CronSpec {
        text = "0 2 * * *"
      }
    }
    fullBackupSpec = new Mapping {}
  }
}
