amends "@formae/forma.pkl"

import "@gcp/compute/healthCheck.pkl"
import "@gcp/compute/backendService.pkl"
import "@gcp/compute/urlMap.pkl"
import "@gcp/compute/targetHttpProxy.pkl"
import "./config/vars.pkl" as v

// Global external HTTP LB chain: HealthCheck -> BackendService -> UrlMap ->
// TargetHttpProxy. Each upstream resource is referenced via its resolvable so
// formae creates them in dependency order.
forma {
  local hc = new healthCheck.HealthCheck {
    label = "plugin-sdk-test-thp-healthcheck"
    name = "formae-plugin-sdk-test-thp-hc-\(v.testRunID)"
    type = "HTTP"
    checkIntervalSec = 10
    timeoutSec = 5
    healthyThreshold = 2
    unhealthyThreshold = 3
    httpHealthCheck = new healthCheck.HttpHealthCheck {
      port = 80
      requestPath = "/"
      proxyHeader = "NONE"
    }
  }

  local bs = new backendService.BackendService {
    label = "plugin-sdk-test-thp-backend-service"
    name = "formae-plugin-sdk-test-thp-bs-\(v.testRunID)"
    loadBalancingScheme = "EXTERNAL_MANAGED"
    protocol = "HTTP"
    timeoutSec = 30
    healthChecks = new Listing {
      hc.res.selfLink
    }
  }

  local um = new urlMap.UrlMap {
    label = "plugin-sdk-test-thp-url-map"
    name = "formae-plugin-sdk-test-thp-um-\(v.testRunID)"
    defaultService = bs.res.selfLink
  }

  v.stack
  v.target

  hc
  bs
  um

  new targetHttpProxy.TargetHttpProxy {
    label = "plugin-sdk-test-target-http-proxy"
    name = "formae-plugin-sdk-test-thp-\(v.testRunID)"
    description = "Test target HTTP proxy for plugin SDK conformance tests"
    urlMap = um.res.selfLink
  }
}
