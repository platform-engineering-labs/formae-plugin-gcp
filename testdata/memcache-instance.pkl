amends "@formae/forma.pkl"

import "@gcp/memcache/memcacheInstance.pkl" as memcacheInstance
import "@gcp/compute/network.pkl"
import "@gcp/compute/globalAddress.pkl"
import "@gcp/servicenetworking/connection.pkl"
import "./config/vars.pkl" as v

// A memcached instance reaches its nodes over private service access, and the
// API refuses outright without it: "Google private service access is not
// enabled." So the chain is a VPC, a reserved range for the producer to peer
// into, the peering itself, and only then the instance.
//
// The instance is billed by node-hour for as long as it exists - one node of
// the smallest size here - and takes twenty minutes or more to create, which
// makes this among the slowest cases in the suite.
local net = new network.Network {
  label = "plugin-sdk-test-mc-network"
  name = "formae-test-mc-net-\(v.testRunID)"
  autoCreateSubnetworks = false
}

local peerRange = new globalAddress.GlobalAddress {
  label = "plugin-sdk-test-mc-range"
  name = "formae-test-mc-range-\(v.testRunID)"
  addressType = "INTERNAL"
  purpose = "VPC_PEERING"
  prefixLength = 16
  network = net.res.selfLink
}

// The connection names the network by its short name rather than its self link.
// A Connection echoes the network reference it was given back as its own
// "network" property, and the instance below points authorizedNetwork at that
// property - so this is what the instance's declared value resolves to. Memcache
// reports authorizedNetwork as a bare name, authorizedNetwork is createOnly, and
// a self link never equals a bare name: with the link here, re-applying the
// extracted forma planned a delete and a create. The Connection accepts any of
// the three forms.
local psa = new connection.Connection {
  label = "plugin-sdk-test-mc-psa"
  network = net.res.name
  reservedPeeringRanges = new Listing {
    peerRange.res.name
  }
}

forma {
  v.stack
  v.target

  net
  peerRange
  psa

  new memcacheInstance.Instance {
    label = "plugin-sdk-test-memcache-instance"
    project = v.gcpProject
    name = "formae-test-mc-\(v.testRunID)"
    displayName = "Plugin SDK conformance"
    // Resolvable through the peering, not the network: the instance needs
    // private service access to exist, not merely the VPC, and naming the
    // connection is what orders it after the peering is established.
    authorizedNetwork = psa.res.network
    nodeCount = 1
    nodeConfig = new memcacheInstance.NodeConfig {
      cpuCount = 1
      memorySizeMb = 1024
    }
  }
}
