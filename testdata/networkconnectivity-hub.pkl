amends "@formae/forma.pkl"

import "@gcp/networkconnectivity/hub.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new hub.Hub {
    label = "plugin-sdk-test-hub"
    name = "formae-test-hub-\(v.testRunID)"
    description = "Test Network Connectivity hub for plugin SDK conformance tests"
  }
}
