amends "@formae/forma.pkl"

import "@gcp/compute/network.pkl"
import "@gcp/compute/subnetwork.pkl"
import "@gcp/container/cluster.pkl"
import "@gcp/container/nodepool.pkl"
import "./config/vars.pkl" as v

// Self-contained GKE fixture. The project's compute.vmExternalIpAccess org
// policy forbids external IPs on nodes, so the cluster must use private nodes.
// Private nodes need egress to pull images: privateIpGoogleAccess=true on the
// subnet gives them Google-API access (Artifact Registry/GCR) without Cloud NAT.
// VPC-native (IP aliasing) needs named pod/service secondary ranges on the
// subnet. Resolvable refs order network -> subnet -> cluster -> nodepool.
// NOTE: GKE is slow (~10-15 min) - run with TIMEOUT=25.
forma {
  local net = new network.Network {
    label = "plugin-sdk-test-gke-network"
    name = "formae-plugin-sdk-test-gke-net-\(v.testRunID)"
    description = "GKE test VPC"
    autoCreateSubnetworks = false
    routingConfig = new network.RoutingConfig {
      routingMode = "REGIONAL"
    }
  }

  local subnet = new subnetwork.Subnetwork {
    label = "plugin-sdk-test-gke-subnet"
    name = "formae-plugin-sdk-test-gke-subnet-\(v.testRunID)"
    description = "GKE test subnet (VPC-native, private google access)"
    network = net.res.selfLink
    ipCidrRange = "10.40.0.0/24"
    region = v.gcpRegion
    privateIpGoogleAccess = true
    secondaryIpRanges = new Listing {
      new subnetwork.SecondaryIpRange {
        rangeName = "gke-pods"
        ipCidrRange = "10.41.0.0/16"
      }
      new subnetwork.SecondaryIpRange {
        rangeName = "gke-services"
        ipCidrRange = "10.42.0.0/20"
      }
    }
  }

  v.stack
  v.target

  net
  subnet

  local gke = new cluster.Cluster {
    label = "plugin-sdk-test-cluster"
    name = "formae-plugin-sdk-test-cluster-\(v.testRunID)"
    location = v.gcpZone
    // selfLink (server-generated) forces formae to finish creating the subnet
    // before the cluster - using the short name raced and GKE saw "subnet not found".
    network = net.res.selfLink
    subnetwork = subnet.res.selfLink
    initialNodeCount = 1
    ipAllocationPolicy = new cluster.IPAllocationPolicy {
      useIpAliases = true
      clusterSecondaryRangeName = "gke-pods"
      servicesSecondaryRangeName = "gke-services"
    }
    privateClusterConfig = new cluster.PrivateClusterConfig {
      enablePrivateNodes = true
      enablePrivateEndpoint = false
      masterIpv4CidrBlock = "172.16.0.0/28"
    }
  }

  gke

  new nodepool.NodePool {
    label = "plugin-sdk-test-nodepool"
    name = "formae-plugin-sdk-test-pool-\(v.testRunID)"
    cluster = gke.res.name
    location = v.gcpZone
    initialNodeCount = 1
  }
}
