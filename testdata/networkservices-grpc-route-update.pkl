amends "@formae/forma.pkl"

import "@gcp/networkservices/mesh.pkl"
import "@gcp/networkservices/grpcRoute.pkl"
import "./config/vars.pkl" as v

// A gRPC route needs a mesh to attach to, so the mesh comes first, passed as a
// resolvable directly - that is what creates the dependency edge and orders the
// creates.
//
// Both are free. A mesh allocates nothing until a workload joins it, and this
// route's action injects a fault rather than naming a destination: a gRPC
// route's rule requires an action but the action does not require a
// destination, so there is no backend service and no health check behind this.
// (A rule with no action at all is refused - "RouteRule requires an action".)
//
// The update rewrites the matched method and the injected fault, and shortens
// the timeout.
//
// Every field of the route is restated, not just the changed ones: this API
// validates a PATCH from the request body alone rather than merging it over
// stored state, so the required `hostnames` and `rules` have to ride along or
// the call is refused. The labels are restated because an unmasked `labels` is
// cleared outright.
local net = new mesh.Mesh {
  label = "plugin-sdk-test-ns-gr-mesh"
  name = "formae-test-ns-gr-mesh-\(v.testRunID)"
  description = "Mesh for the gRPC route conformance test"
  labels = new Mapping {
    ["environment"] = "test"
  }
}

forma {
  v.stack
  v.target

  net

  new grpcRoute.GrpcRoute {
    label = "plugin-sdk-test-ns-grpc-route"
    name = "formae-test-ns-gr-\(v.testRunID)"
    hostnames = new Listing {
      "formae-test-gr-\(v.testRunID).example.com"
    }
    meshes = new Listing {
      net.res.name
    }
    rules = new Listing {
      new grpcRoute.GrpcRouteRule {
        matches = new Listing {
          new grpcRoute.GrpcRouteMatch {
            method = new grpcRoute.MethodMatch {
              type = "EXACT"
              grpcService = "helloworld.Greeter"
              grpcMethod = "SayHelloAgain"
            }
          }
        }
        action = new grpcRoute.GrpcRouteAction {
          faultInjectionPolicy = new grpcRoute.GrpcFaultInjectionPolicy {
            abort = new grpcRoute.GrpcFaultInjectionAbort {
              httpStatus = 500
              percentage = 50
            }
          }
          timeout = "5s"
        }
      }
    }
    description = "Updated test gRPC route description"
    labels = new Mapping {
      ["environment"] = "test"
    }
  }
}
