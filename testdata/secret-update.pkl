amends "@formae/forma.pkl"

import "@gcp/secretmanager/secret.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new secret.Secret {
    label = "plugin-sdk-test-secret"
    name = "formae-test-secret-\(v.testRunID)"   // Same (createOnly)
    labels = new Mapping {
      ["environment"] = "production"   // Changed (mutable)
      ["managed-by"] = "formae"
    }
  }
}
