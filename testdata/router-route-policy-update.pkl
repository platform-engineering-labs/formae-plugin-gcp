amends "@formae/forma.pkl"

import "@gcp/compute/network.pkl"
import "@gcp/compute/router.pkl"
import "@gcp/compute/routerRoutePolicy.pkl"
import "./config/vars.pkl" as v

// Network + router + the route policy that makes the router selective about
// which routes it accepts. No BGP peer is needed for the policy to exist.
local net = new network.Network {
  label = "plugin-sdk-test-rrp-network"
  name = "formae-plugin-sdk-test-rrp-net-\(v.testRunID)"
  autoCreateSubnetworks = false
}

local rt = new router.Router {
  label = "plugin-sdk-test-rrp-router"
  name = "formae-plugin-sdk-test-rrp-rt-\(v.testRunID)"
  region = v.gcpRegion
  network = net.res.selfLink
}

forma {
  v.stack
  v.target

  net
  rt

  new routerRoutePolicy.RouterRoutePolicy {
    label = "plugin-sdk-test-router-route-policy"
    name = "formae-plugin-sdk-test-rrp-\(v.testRunID)"
    // Resolvable -> the router exists before the update verb runs.
    router = rt.res.name
    region = v.gcpRegion
    type = "ROUTE_POLICY_TYPE_IMPORT"
    terms = new Listing {
      new routerRoutePolicy.RoutePolicyTerm {
        priority = 2
        match = new routerRoutePolicy.RoutePolicyExpr {
          // RFC 1918 space, so the policy describes nothing routable publicly.
          expression = "destination == '172.16.0.0/12'"
        }
        actions = new Listing {
          new routerRoutePolicy.RoutePolicyExpr {
            expression = "accept()"
          }
        }
      }
    }
  }
}
