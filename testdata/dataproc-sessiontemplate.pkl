amends "@formae/forma.pkl"

import "@gcp/dataproc/sessionTemplate.pkl"
import "./config/vars.pkl" as v

// A serverless Spark session template with no prerequisites. Templates are free
// — only sessions started from one are billed, and nothing starts a session
// here.
forma {
  v.stack
  v.target

  new sessionTemplate.SessionTemplate {
    label = "plugin-sdk-test-dataproc-session-template"
    name = "formae-test-st-\(v.testRunID)"
    description = "Test session template for plugin SDK conformance tests"
    jupyterSession = new sessionTemplate.JupyterSession {
      kernel = "PYTHON"
      displayName = "conformance probe"
    }
    runtimeConfig = new sessionTemplate.SessionRuntimeConfig {
      version = "2.2"
    }
  }
}
