amends "@formae/forma.pkl"

import "@gcp/secretmanager/secret.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new secret.Secret {
    label = "plugin-sdk-test-secret"
    name = "formae-plugin-sdk-test-secret-\(v.testRunID)"
    replication = new secret.Replication {
      automatic = new secret.AutomaticReplication {}
    }
    labels = new Mapping {
      ["environment"] = "test"
      ["managed-by"] = "formae"
    }
  }
}
