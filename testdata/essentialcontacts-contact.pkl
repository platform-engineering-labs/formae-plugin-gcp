amends "@formae/forma.pkl"

import "@gcp/essentialcontacts/contact.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new contact.Contact {
    label = "plugin-sdk-test-contact"
    email = "formae-test-\(v.testRunID)@platform.engineering"
    notificationCategorySubscriptions = new Listing { "ALL" }
    languageTag = "en-US"
  }
}
