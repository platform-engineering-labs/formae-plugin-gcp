amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@gcp/gcp.pkl"

import "@gcp/compute/disk.pkl"

import "./config/vars.pkl" as v

local stackName = "plugin-sdk-test-stack"

forma {
  v.stack
  v.target

  new disk.Disk {
    label = "plugin-sdk-test-disk"
    project = v.gcpProject
    zone = v.gcpZone
    name = "formae-plugin-sdk-test-\(v.testRunID)"
    description = "Test disk for plugin SDK tests"
    sizeGb = 10
    type = "pd-standard"
    sourceImage = formae.value("projects/debian-cloud/global/images/family/debian-12")
    labels = new Mapping {
      ["environment"] = "test"
      ["managed-by"] = "formae"
      ["updated"] = "true"  // New label added in update
    }
  }
}
