amends "@formae/forma.pkl"

import "@gcp/compute/httpsHealthCheck.pkl"
import "./config/vars.pkl" as v

// Zero-dependency legacy HTTPS health check, for target pools whose backends
// terminate TLS.
forma {
  v.stack
  v.target

  new httpsHealthCheck.HttpsHealthCheck {
    label = "plugin-sdk-test-https-health-check"
    name = "formae-plugin-sdk-test-hhcs-\(v.testRunID)"
    description = "Updated legacy HTTPS health check description"
    port = 443
    requestPath = "/ready"
    checkIntervalSec = 15
    timeoutSec = 5
    healthyThreshold = 2
    unhealthyThreshold = 3
  }
}
