amends "@formae/forma.pkl"

import "@gcp/pubsub/topic.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new topic.Topic {
    label = "plugin-sdk-test-pubsub-topic"
    name = "formae-test-topic-\(v.testRunID)"   // Same (createOnly)
    labels = new Mapping {
      ["environment"] = "production"   // Changed (mutable)
      ["managed-by"] = "formae"
    }
    messageRetentionDuration = "86400s"   // Added (mutable)
  }
}
