amends "@formae/forma.pkl"

import "@gcp/servicedirectory/namespace.pkl"
import "@gcp/servicedirectory/service_servicedirectory.pkl" as service
import "@gcp/servicedirectory/endpoint.pkl"
import "./config/vars.pkl" as v

// An endpoint is what a resolve call actually returns, so it needs the two
// collections above it. Both are free, and referencing them through their
// resolvables orders the creates.
local ns = new namespace.Namespace {
  label = "plugin-sdk-test-sd-ep-namespace"
  name = "formae-test-sd-ep-ns-\(v.testRunID)"
}

local svc = new service.Service {
  label = "plugin-sdk-test-sd-ep-service"
  name = "formae-test-sd-ep-svc-\(v.testRunID)"
  namespace = ns.res.name
}

forma {
  v.stack
  v.target

  ns
  svc

  new endpoint.Endpoint {
    label = "plugin-sdk-test-sd-endpoint"
    name = "formae-test-sd-ep-\(v.testRunID)"
    namespace = ns.res.name
    service = svc.res.name
    address = "10.20.30.41"
    port = 9090
  }
}
