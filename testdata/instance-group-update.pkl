amends "@formae/forma.pkl"
import "@formae/formae.pkl"

import "@gcp/compute/network.pkl"
import "@gcp/compute/subnetwork.pkl"
import "@gcp/compute/disk.pkl"
import "@gcp/compute/instance.pkl"
import "@gcp/compute/instanceGroup.pkl"
import "./config/vars.pkl" as v

// Update variant of instance-group.pkl: the VM/net/subnet/disk are unchanged,
// but the group drops its member (removeInstances) and changes the named port
// (setNamedPorts with fingerprint). The group's NativeID must stay stable —
// this is an in-place update, not a replace.
local net = new network.Network {
  label = "plugin-sdk-test-ig-net"
  name = "formae-plugin-sdk-test-ig-net-\(v.testRunID)"
  autoCreateSubnetworks = false
}
local subnet = new subnetwork.Subnetwork {
  label = "plugin-sdk-test-ig-subnet"
  name = "formae-plugin-sdk-test-ig-subnet-\(v.testRunID)"
  network = net.res.selfLink
  region = v.gcpRegion
  ipCidrRange = "10.91.0.0/24"
}

forma {
  local bootDisk = new disk.Disk {
    label = "plugin-sdk-test-ig-bootdisk"
    project = v.gcpProject
    zone = v.gcpZone
    name = "formae-plugin-sdk-test-ig-disk-\(v.testRunID)"
    description = "Boot disk for instance-group member VM"
    sizeGb = 10
    type = "pd-standard"
    sourceImage = formae.value("projects/debian-cloud/global/images/family/debian-12")
  }

  local memberVm = new instance.Instance {
    label = "plugin-sdk-test-ig-vm"
    project = v.gcpProject
    zone = v.gcpZone
    name = "formae-plugin-sdk-test-ig-vm-\(v.testRunID)"
    machineType = "e2-micro"
    description = "Member VM for instance-group conformance test"
    disks = new Listing {
      new instance.AttachedDisk {
        boot = true
        autoDelete = false
        source = bootDisk.res.selfLink
      }
    }
    networkInterfaces = new Listing {
      new instance.NetworkInterface {
        network = net.res.selfLink
        subnetwork = subnet.res.selfLink
      }
    }
  }

  v.stack
  v.target

  net
  subnet
  bootDisk
  memberVm

  new instanceGroup.InstanceGroup {
    label = "plugin-sdk-test-instance-group"
    name = "formae-plugin-sdk-test-ig-\(v.testRunID)"
    description = "Test unmanaged instance group with a VM member"
    zone = v.gcpZone
    // Named port changed (80 -> 49684) exercises setNamedPorts with fingerprint.
    namedPorts = new Listing {
      new instanceGroup.NamedPort {
        name = "formae"
        port = 49684
      }
    }
    // Member dropped exercises removeInstances; the read then omits `instances`.
  }
}
