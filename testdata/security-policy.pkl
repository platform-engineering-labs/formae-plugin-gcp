amends "@formae/forma.pkl"

import "@gcp/compute/securityPolicy.pkl"
import "./config/vars.pkl" as v

forma {
  v.stack
  v.target

  new securityPolicy.SecurityPolicy {
    label = "plugin-sdk-test-security-policy"
    name = "formae-plugin-sdk-test-secpol-\(v.testRunID)"
    description = "Test Cloud Armor policy for plugin SDK conformance tests"
    type = "CLOUD_ARMOR"
    rules = new Listing {
      // Required default rule.
      new securityPolicy.Rule {
        action = "allow"
        priority = 2147483647
        description = "default allow rule"
        match = new securityPolicy.Match {
          versionedExpr = "SRC_IPS_V1"
          config = new securityPolicy.MatchConfig {
            srcIpRanges = new Listing { "*" }
          }
        }
      }
    }
  }
}
