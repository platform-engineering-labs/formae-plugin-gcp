amends "@formae/forma.pkl"

import "@gcp/parametermanager/parameter.pkl"
import "@gcp/parametermanager/parameterVersion.pkl"
import "./config/vars.pkl" as v

// A version holds the actual contents, so it needs a parameter above it. Both
// are free: a parameter is a container and a version is a few bytes of stored
// configuration. No CMEK on the parameter, so no KMS key version - which would
// bill monthly - has to exist.
//
// The parameter is referenced through its resolvable, which is what orders both
// halves of the lifecycle. On create the parameter comes first; on destroy the
// version goes first - which matters here, because a parameter that still has
// versions refuses to delete with HTTP 400 FAILED_PRECONDITION and this API's
// delete takes no force flag. Interpolating the parameter's name into a string
// would carry no edge and the teardown would fail.
//
// format is left at the API's own default of UNFORMATTED so the payload can be
// a plain string; YAML or JSON would have the API parse it and reject a version
// that does not conform.
local param = new parameter.Parameter {
  label = "plugin-sdk-test-pm-pv-parameter"
  name = "formae-test-pm-pvp-\(v.testRunID)"
}

forma {
  v.stack
  v.target

  param

  new parameterVersion.ParameterVersion {
    label = "plugin-sdk-test-pm-parameter-version"
    name = "formae-test-pm-pv-\(v.testRunID)"
    parameter = param.res.name
    // Plain string: the plugin base64 encodes it into the API's payload.data,
    // and strips the payload back out of every response so the contents never
    // reach stored state. Left unwrapped so the discovery test's direct
    // out-of-band create (which bypasses the agent's opaque unwrapping) still
    // sends a JSON string.
    data = "formae-test-parameter-payload"
    // disabled is left out deliberately: the API ignores it on create (a create
    // sending true answers 200 and the version is still enabled) and omits it
    // from a response when false. The -update companion is what sets it.
  }
}
