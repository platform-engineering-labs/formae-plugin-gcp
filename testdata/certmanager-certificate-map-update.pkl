amends "@formae/forma.pkl"

import "@gcp/certificatemanager/certificateMap.pkl" as certificateMap
import "./config/vars.pkl" as v

// A map with no entries is valid and serves nothing, which keeps this case free
// of prerequisites.
forma {
  v.stack
  v.target

  new certificateMap.CertificateMap {
    label = "plugin-sdk-test-certmanager-map"
    name = "formae-test-certmap-\(v.testRunID)"
    description = "Updated certificate map description"
    labels = new Mapping {
      ["environment"] = "updated"
      ["managed-by"] = "formae"
    }
  }
}
