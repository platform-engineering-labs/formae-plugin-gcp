amends "@formae/forma.pkl"

import "@gcp/dns/responsePolicy.pkl"
import "@gcp/dns/responsePolicyRule.pkl"
import "./config/vars.pkl" as v

// A rule lives inside a response policy, so that comes first. The policy needs
// no network: every fixture that builds one competes for a project-wide cap of
// 30 networks that a full matrix already runs up against.

local rp = new responsePolicy.ResponsePolicy {
  label = "plugin-sdk-test-dnsrpr-policy"
  project = v.gcpProject
  responsePolicyName = "formae-plugin-sdk-test-dnsrpr-\(v.testRunID)"
  description = "Plugin SDK conformance response policy for a rule"
}

forma {
  v.stack
  v.target

  rp

  new responsePolicyRule.ResponsePolicyRule {
    label = "plugin-sdk-test-dns-response-policy-rule"
    project = v.gcpProject
    // Resolvable -> the response policy exists before a rule is added to it.
    responsePolicy = rp.res.responsePolicyName
    // The id is immutable, so changing it forces a replace rather than an
    // update. The response policy above is a prerequisite and stays put.
    ruleName = "formae-plugin-sdk-test-dnsrule-r2-\(v.testRunID)"
    // example.com is reserved for documentation, so this overrides nothing real.
    dnsName = "conformance.example.com."
    localData = new responsePolicyRule.LocalData {
      localDatas = new Listing {
        new responsePolicyRule.LocalDataRecordSet {
          name = "conformance.example.com."
          type = "A"
          ttl = 300
          rrdatas = new Listing { "192.0.2.10" }
        }
      }
    }
  }
}
