amends "@formae/forma.pkl"

import "@gcp/dns/responsePolicy.pkl" as responsePolicy
import "@gcp/dns/responsePolicyRule.pkl" as responsePolicyRule
import "./config/vars.pkl" as v

// The replace companion of dns-response-policy-rule. The policy above the rule
// is the prerequisite and does not move; the rule id does, and it is immutable,
// so the plan is a destroy and a create rather than an update.
local policy = new responsePolicy.ResponsePolicy {
  label = "plugin-sdk-test-dns-rule-policy"
  name = "formae-test-dns-rule-rp-\(v.testRunID)"
  description = "Response policy owning the rule under test"
}

forma {
  v.stack
  v.target

  policy

  new responsePolicyRule.ResponsePolicyRule {
    label = "plugin-sdk-test-dns-response-policy-rule"
    name = "formae-test-dns-rule2-\(v.testRunID)"
    responsePolicy = policy.res.name
    dnsName = "formae-\(v.testRunID).internal.example.com."
    localData = new responsePolicyRule.LocalData {
      localDatas = new Listing {
        new responsePolicyRule.LocalDataRecordSet {
          name = "formae-\(v.testRunID).internal.example.com."
          type = "A"
          ttl = 300
          rrdatas = new Listing { "10.0.0.1" }
        }
      }
    }
  }
}
