amends "@formae/forma.pkl"

import "@gcp/filestore/filestoreInstance.pkl"
import "@gcp/filestore/filestoreSnapshot.pkl" as snapshot
import "./config/vars.pkl" as v

// A snapshot lives inside its instance, in the same zone, so the instance comes
// first. run-conformance-case.sh points GCP_LOCATION at GCP_ZONE for this case,
// so both inherit the zone.
//
// The instance is ZONAL, not the BASIC_HDD the other Filestore cases use:
// "The service tier of the specified instance doesn't support snapshots".
// Snapshots need ZONAL, REGIONAL or ENTERPRISE; the BASIC tiers only support
// backups. ZONAL has a 1 TiB minimum and costs more per GiB than BASIC_HDD, so
// this case is the more expensive of the two - a reason to keep it short and to
// make sure the instance is swept afterwards (clean-filestore-case.sh).
local sourceFs = new filestoreInstance.Instance {
  label = "plugin-sdk-test-snapshot-instance"
  name = "formae-test-snap-fs-\(v.testRunID)"
  tier = "ZONAL"
  fileShares {
    new {
      name = "share1"
      capacityGb = 1024
    }
  }
  networks {
    new {
      network = "default"
      modes {
        "MODE_IPV4"
      }
    }
  }
}

forma {
  v.stack
  v.target

  sourceFs

  new snapshot.Snapshot {
    label = "plugin-sdk-test-filestore-snapshot"
    name = "formae-test-snap-\(v.testRunID)"
    location = v.gcpZone
    // Resolvable -> the instance exists before the snapshot is taken. The
    // local is not called "instance": inside the Snapshot body that name is the
    // property being defined, and "instance = instance.res.name" resolves to
    // itself until Pkl overflows its stack.
    instance = sourceFs.res.name
    description = "Created by the formae GCP plugin conformance suite."
  }
}
