amends "@formae/forma.pkl"

import "@gcp/eventarc/trigger.pkl"
import "./config/vars.pkl" as v

// NOTE: a working Trigger requires a real destination (a deployed Cloud Run
// service) to exist first. This fixture points at a placeholder service name;
// conformance create will only succeed once that Cloud Run service dependency
// exists in the target project/region.
forma {
  v.stack
  v.target

  new trigger.Trigger {
    label = "plugin-sdk-test-eventarc-trigger"
    name = "formae-test-trigger-\(v.testRunID)"
    eventFilters = new Listing {
      new trigger.EventFilter {
        attribute = "type"
        value = "google.cloud.pubsub.topic.v1.messagePublished"
      }
    }
    destination = new trigger.Destination {
      cloudRun = new trigger.CloudRun {
        service = "formae-test-eventarc-target"
        region = v.gcpRegion
        path = "/"
      }
    }
  }
}
