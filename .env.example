# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_PROJECT_NUMBER=123456789012
GCP_REGION=europe-central2
GCP_ZONE=europe-central2-b

# Local development only - path to service account JSON key
# Leave unset in CI to use Application Default Credentials (ADC) via Workload Identity Federation
GCP_CREDENTIALS_FILE=/path/to/your/credentials.json
