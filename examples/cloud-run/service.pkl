amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@gcp/cloudrun/service.pkl"

forma {
  new formae.Target {
    label = "cloudrun-target"
    namespace = "GCP"
    discoverable = true
    config {
      Type = "GCP"
      Project = "development-477117"
      Region = "us-west1"
      Location = "us-west1"
    }
  }

  local crStack = new formae.Stack {
    label = "cloudrun-test-stack"
    description = "Cloud Run test stack"
  }
  crStack

  new service.Service {
    label = "formae-test-svc-2"
    stack = crStack.res
    project = "development-477117"
    region = "us-west1"
    name = "formae-test-svc-2"
    template = new service.RevisionTemplate {
      containers = new Listing {
        new service.Container {
          image = "us-docker.pkg.dev/cloudrun/container/hello"
        }
      }
    }
  }
}
