amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@gcp/cloudrun/job.pkl"

forma {
  new formae.Target {
    label = "cr-job-target"
    namespace = "GCP"
    discoverable = false
    config {
      Type = "GCP"
      Project = "development-477117"
      Region = "us-west1"
      Location = "us-west1"
    }
  }

  local crStack = new formae.Stack {
    label = "cr-job-stack"
    description = "Cloud Run Job test stack"
  }
  crStack

  new job.Job {
    label = "formae-cr-job"
    stack = crStack.res
    project = "development-477117"
    region = "us-west1"
    name = "formae-cr-job"
    template = new job.ExecutionTemplate {
      template = new job.TaskTemplate {
        containers = new Listing {
          new job.Container {
            image = "us-docker.pkg.dev/cloudrun/container/hello"
          }
        }
      }
    }
  }
}
