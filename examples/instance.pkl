amends "@formae/forma.pkl"
import "@formae/formae.pkl"

// Resource imports
import "@gcp/compute/instance.pkl"
import "@gcp/gcp.pkl"

forma {

  local gcpStack = new formae.Stack {
    label = "gcp-stack"
    description = "This was generated"
  }
  gcpStack


  local gcpTarget = new formae.Target {
    label = "gcp-target"
    namespace = "GCP"
    discoverable = true
    // Credentials are read from GCP_CREDENTIALS_FILE or GCP_CREDENTIALS_JSON env vars
    config {
      Type = "GCP"
      Project = "development-477117"
      Region = "europe-west4"
    }
  }
  gcpTarget

  new instance.Instance {
    label = "demo-instance"
    project = "development-477117"
    zone = "https://www.googleapis.com/compute/v1/projects/development-477117/zones/europe-west4-b"
    name = "formae-demo-instance"
    machineType = "https://www.googleapis.com/compute/v1/projects/development-477117/zones/europe-west4-b/machineTypes/e2-small"
    disks = new Listing { new instance.AttachedDisk {
        autoDelete = false
        boot = true
        mode = "READ_WRITE"
        source = new instance.Resolvable {
          $res = true
          $visibility = "Clear"
        }
        type = "PERSISTENT"
      } }
    networkInterfaces = new Listing { new instance.NetworkInterface {
        network = new instance.Resolvable {
          $res = true
          $visibility = "Clear"
        }
        subnetwork = new instance.Resolvable {
          $res = true
          $visibility = "Clear"
        }
        name = "nic0"
        networkIP = "10.0.1.2"
      } }
    labels = new Mapping {
      ["environment"] = "demo"
      ["project"] = "formae-lifeline"
    }
    metadata = new instance.Metadata {

    }
    scheduling = new instance.Scheduling {
      automaticRestart = true
      onHostMaintenance = "MIGRATE"
      preemptible = false
      provisioningModel = "STANDARD"
    }
    deletionProtection = false
    target = gcpTarget.res
    stack = gcpStack.res
  }
}