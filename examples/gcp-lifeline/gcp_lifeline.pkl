amends "@formae/forma.pkl"
import "@formae/formae.pkl"
import "@formae/ext/random.pkl"
import "@gcp/gcp.pkl"
import "@gcp/compute/network.pkl"
import "@gcp/compute/firewall.pkl"
import "@gcp/compute/subnetwork.pkl"
import "@gcp/compute/router.pkl"
import "@gcp/compute/instance.pkl"
import "@gcp/compute/disk.pkl"


local Region = "europe-west4"

local target: formae.Target = new formae.Target {
    label = "gcp-target"
    config = new gcp.Config{
        project = "development-477117"
        region = Region
    }
}

local stack: formae.Stack = new {
    label = "gcp-stack"
    description = "Stack for the lifeline showcase"
}

local vpcNetwork = new network.Network {
    label = "formae-demo-vpc"
    description = "Formae demo VPC network"
    name = "formae-demo-network"
    autoCreateSubnetworks = false
    routingConfig = new network.RoutingConfig {
      routingMode = "REGIONAL"
      bgpBestPathSelectionMode = "LEGACY"
    }
    networkFirewallPolicyEnforcementOrder = "AFTER_CLASSIC_FIREWALL"
  }

local publicSubnet = new subnetwork.Subnetwork {
    label = "public-subnet-a"
    name = "public-subnet-eu-central1-a"
    network = vpcNetwork.res.selfLink
    region = Region
    ipCidrRange = "10.0.1.0/24"
    privateIpGoogleAccess = false
}

local privateSubnet = new subnetwork.Subnetwork {
    label = "private-subnet-a"
    name = "private-subnet-eu-central1-a"
    network = vpcNetwork.res.selfLink
    region = Region
    ipCidrRange = "10.0.10.0/24"
    privateIpGoogleAccess = true
}

local allowSshFirewall = new firewall.Firewall {
    label = "allow-ssh"
    name = "allow-ssh-from-internet"
    network = vpcNetwork.res.selfLink
    direction = "INGRESS"
    sourceRanges {
         "0.0.0.0/0"
    }
    allowed {
        new {
            protocol = "tcp"
            ports { "22" }
        }
    }
}

local allowHttpFirewall = new firewall.Firewall {
    label = "allow-http"
    name = "allow-http-from-internet"
    network = vpcNetwork.res.selfLink
    direction = "INGRESS"
    sourceRanges { "0.0.0.0/0" }
    allowed {
        new {
            protocol = "tcp"
            ports { "80"; "443"}
        }
    }
}

local r = new router.Router {
    label = "vpc-router"
    name = "formae-demo-router"
    network = vpcNetwork.res.selfLink
    region = Region
}

forma {
    stack
    target
    vpcNetwork
    publicSubnet
    privateSubnet
    allowSshFirewall
    allowHttpFirewall
    r
}