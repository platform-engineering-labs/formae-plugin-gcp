/// GCP BigQuery Connection
///
/// A named handle BigQuery uses to reach something outside itself — Cloud SQL,
/// Spark, or Google Cloud resources generally. A `cloudResource` connection is
/// the simplest: BigQuery mints a service account for it, and granting that
/// account access is how a query reaches the resource.
///
/// Holding a connection costs nothing; BigQuery bills queries.
module gcp.bigquery.bigqueryConnection

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::BigQuery::Connection"

/// A connection to Google Cloud resources. It carries no configuration: the
/// server fills in the service account it created.
class CloudResourceProperties {
    /// The service account BigQuery created for this connection. Grant it
    /// access to whatever the connection should reach.
    @gcp.FieldHint { hasProviderDefault = true }
    serviceAccountId: String?
}

open class ConnectionResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: ConnectionResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class Connection extends formae.Resource {
    hidden parent = this

    /// Short connection id, unique within the location. Immutable.
    @gcp.FieldHint { createOnly = true }
    name: String

    /// The project holding the connection.
    @gcp.FieldHint { createOnly = true }
    project: (String|formae.Resolvable)?

    /// The location the connection lives in. BigQuery connections live in a
    /// region or in a multi-region such as "US" or "EU".
    @gcp.FieldHint { hasProviderDefault = true }
    location: String?

    @gcp.FieldHint
    friendlyName: String?

    @gcp.FieldHint
    description: String?

    /// Reach Google Cloud resources through a service account BigQuery mints.
    @gcp.FieldHint
    cloudResource: CloudResourceProperties?

    /// Whether the connection has credentials configured - server-reported.
    @gcp.FieldHint { hasProviderDefault = true }
    hasCredential: Boolean?

    hidden res: ConnectionResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
