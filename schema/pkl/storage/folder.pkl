module gcp.storage.folder

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Storage::Folder"

open class FolderResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: FolderResolvable = (this) {
        property = "Name"
    }

    hidden bucket: FolderResolvable = (this) {
        property = "Bucket"
    }

    hidden createTime: FolderResolvable = (this) {
        property = "CreateTime"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "Name"
}
open class Folder extends formae.Resource {
    hidden parent = this

    /// The name of the bucket that contains the folder
    @gcp.FieldHint {
        createOnly = true
    }
    bucket: String|formae.Resolvable

    /// The name of the folder expressed as a path (must include trailing '/')
    /// Example: `example_dir/example_dir2/`, `example@#/`, `a-b/d-f/`
    /// Note: Only works with buckets that have hierarchical namespace enabled
    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    /// If set to true, items within folder will be force destroyed
    forceDestroy: Boolean?

    /// The timestamp at which this folder was created (output only)
    @gcp.FieldHint {
        persist = false
    }
    createTime: String?

    /// The timestamp at which this folder was most recently updated (output only)
    @gcp.FieldHint {
        persist = false
    }
    updateTime: String?

    /// The version of the metadata for this folder (output only)
    @gcp.FieldHint {
        persist = false
    }
    metageneration: String?

    hidden res: FolderResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
