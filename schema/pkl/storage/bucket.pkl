module gcp.compute.bucket

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Storage::Bucket"

typealias StorageClass = "MULTI_REGIONAL"|"REGIONAL"|"STANDARD"|"NEARLINE"|"COLDLINE"|"ARCHIVE"|"DURABLE_REDUCED_AVAILABILITY"

@gcp.SubResourceHint
open class LifecycleAction extends formae.SubResource {
    storageClass: String?
    type: String
}

@gcp.SubResourceHint
open class LifecycleCondition extends formae.SubResource {
    age: Int?
    createdBefore: String?
    customTimeBefore: String?
    daysSinceCustomTime: Int?
    daysSinceNoncurrentTime: Int?
    isLive: Boolean?
    matchesPrefix: Listing<String>?
    matchesStorageClass: Listing<String>?
    matchesSuffix: Listing<String>?
    noncurrentTimeBefore: String?
    numNewerVersions: Int?
}

@gcp.SubResourceHint
open class LifecycleRule extends formae.SubResource {
    action: LifecycleAction?
    condition: LifecycleCondition?
}

@gcp.SubResourceHint
open class Lifecycle extends formae.SubResource {
    rule: Listing<LifecycleRule>?
}

@gcp.SubResourceHint
open class Logging extends formae.SubResource {
    logBucket: String?

    logObjectPrefix: String?
}

@gcp.SubResourceHint
open class Owner extends formae.SubResource {
    entity: String?

    @gcp.FieldHint {
    }
    entityId: String?
}

@gcp.SubResourceHint
open class Versioning extends formae.SubResource {
    enabled: Boolean?
}

/// Uniform bucket-level access. When enabled, access is controlled only by IAM
/// and the bucket rejects ACLs - so a `BucketAccessControl` or
/// `DefaultObjectAccessControl` on such a bucket cannot be created.
@gcp.SubResourceHint
open class UniformBucketLevelAccess extends formae.SubResource {
    @gcp.FieldHint
    enabled: Boolean?
}

@gcp.SubResourceHint
open class IamConfiguration extends formae.SubResource {
    @gcp.FieldHint
    uniformBucketLevelAccess: UniformBucketLevelAccess?

    /// "inherited" or "enforced". Enforcing public access prevention blocks
    /// making objects publicly readable.
    @gcp.FieldHint { hasProviderDefault = true }
    publicAccessPrevention: String?
}

@gcp.SubResourceHint
open class Website extends formae.SubResource {
    mainPageSuffix: String?

    notFoundPage: String?
}

@gcp.SubResourceHint
open class Encryption extends formae.SubResource {
    defaultKmsKeyName: String?
}

@gcp.SubResourceHint
open class RetentionPolicy extends formae.SubResource {
    effectiveTime: String?

    isLocked: Boolean?

    retentionPeriod: Int?
}

open class BucketResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: BucketResolvable = (this) {
        property = "Id"
    }

    hidden selfLink: BucketResolvable = (this) {
        property = "SelfLink"
    }

    hidden name: BucketResolvable = (this) {
        property = "Name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class Bucket extends formae.Resource {
    hidden parent = this

    acl: Listing<Mapping<String, Any>>?

    cors: Listing<Mapping<String, Any>>?

    defaultEventBasedHold: Boolean?

    @gcp.FieldHint {
        createOnly = true
    }
    defaultObjectAcl: Listing<Mapping<String, Any>>?

    @gcp.FieldHint {
        hasProviderDefault = true
    }
    id: String?

    @gcp.FieldHint
    lifecycle: Lifecycle?

    @gcp.FieldHint {
        createOnly = true
    }
    location: gcp.Region

    @gcp.FieldHint
    logging: Logging?

    // metageneration is deliberately not declared. It is the optimistic-locking
    // counter the server increments on every metadata change, and the update
    // path reads it live from the API rather than from the forma, so declaring
    // it only puts an ever-changing value into desired state: extract writes
    // the counter it saw, the apply bumps it, and re-applying the extracted
    // forma then plans a spurious update back to the stale value.

    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    @gcp.FieldHint
    owner: Owner?

    @gcp.FieldHint {
        hasProviderDefault = true
    }
    projectNumber: String?

    @gcp.FieldHint
    storageClass: StorageClass?

    @gcp.FieldHint {
        hasProviderDefault = true
    }
    timeCreated: String?

    @gcp.FieldHint {
        hasProviderDefault = true
    }
    updated: String?

    /// IAM configuration. Set `uniformBucketLevelAccess.enabled = false` to
    /// keep ACLs usable on this bucket; GCP's own default for new buckets has
    /// varied, and an organisation policy can force it on.
    @gcp.FieldHint { hasProviderDefault = true }
    iamConfiguration: IamConfiguration?

    @gcp.FieldHint
    versioning: Versioning?

    @gcp.FieldHint
    website: Website?

    @gcp.FieldHint
    labels: Mapping<String, String>?

    @gcp.FieldHint
    encryption: Encryption?

    @gcp.FieldHint
    retentionPolicy: RetentionPolicy?

    hidden res: BucketResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}