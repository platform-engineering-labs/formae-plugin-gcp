module gcp.storage.anywhere_cache

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Storage::AnywhereCache"

typealias AdmissionPolicy = "admit-on-first-miss"|"admit-on-second-miss"

open class AnywhereCacheResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden anywhereCacheId: AnywhereCacheResolvable = (this) {
        property = "anywhereCacheId"
    }

    hidden bucket: AnywhereCacheResolvable = (this) {
        property = "bucket"
    }

    hidden state: AnywhereCacheResolvable = (this) {
        property = "state"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "AnywhereCacheId"
    parent = "GCP::Storage::Bucket"
    listParam = new Listing<formae.ListProperty> {
        new formae.ListProperty { parentProperty = "name" listParameter = "bucket"
        }
    }.toList()
}
open class AnywhereCache extends formae.Resource {
    hidden parent = this

    /// The name of the bucket that contains the anywhere cache
    @gcp.FieldHint {
        createOnly = true
    }
    bucket: String

    /// The zone in which the cache instance needs to be created
    /// Example: `us-central1-a`
    @gcp.FieldHint {
        createOnly = true
    }
    zone: String

    /// The cache admission policy (whether to cache on first or second miss)
    /// Default: admit-on-first-miss
    admissionPolicy: AdmissionPolicy?

    /// The TTL of all cache entries in whole seconds
    /// Example: "7200s"
    /// Default: "86400s" (24 hours)
    ttl: String?

    /// The ID of the Anywhere cache instance (output only)
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    anywhereCacheId: String?

    /// The creation time of the cache instance in RFC 3339 format (output only)
    /// Set by the API.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    createTime: String?

    /// The modification time of the cache instance metadata in RFC 3339 format (output only)
    /// Set by the API.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    updateTime: String?

    /// True if the cache instance has an active Update long-running operation (output only)
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    pendingUpdate: Boolean?

    /// The current state of the cache instance (output only)
    /// Set by the API.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    state: String?

    hidden res: AnywhereCacheResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
