/// GCP Pub/Sub TopicIamMember
///
/// A single (role, member) binding on a `Topic`'s IAM policy, managed as
/// read-modify-write so sibling bindings survive.
///
/// A binding is modelled rather than the whole policy on purpose: a policy is
/// shared with principals outside the forma - GCP's own service agents write to
/// it - and declaring the whole policy would delete their bindings on every
/// apply.
///
/// All fields are createOnly: a change plans a replace.
module gcp.pubsub.topicIamMember

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::PubSub::TopicIamMember"

/// Resolves to the bound topic, so a resource that needs the binding in place
/// before it is created can reference `binding.res.topic` instead of the
/// topic itself. That is the only way to order against a binding: formae
/// derives ordering from resolvable references, and nothing else references an
/// IAM member.
open class TopicIamMemberResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden topic: TopicIamMemberResolvable = (this) {
        property = "topic"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "topic"
}
open class TopicIamMember extends formae.Resource {
    hidden parent = this

    /// Target topic: its short name (resolved against the target's project) or
    /// a full "projects/{p}/topics/{name}" path. Reference a Topic resource's
    /// resolvable to order creation.
    @gcp.FieldHint { createOnly = true }
    topic: (String|formae.Resolvable)

    /// Project of the topic. Defaults to the target's project when omitted.
    @gcp.FieldHint { createOnly = true; hasProviderDefault = true }
    project: String?

    /// IAM role, e.g. "roles/pubsub.publisher".
    @gcp.FieldHint { createOnly = true }
    role: String

    /// IAM member, e.g. "serviceAccount:x@y.iam.gserviceaccount.com".
    @gcp.FieldHint { createOnly = true }
    member: String

    hidden res: TopicIamMemberResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
