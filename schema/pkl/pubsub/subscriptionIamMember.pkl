/// GCP Pub/Sub SubscriptionIamMember
///
/// A single (role, member) binding on a `Subscription`'s IAM policy, managed as
/// read-modify-write so sibling bindings survive.
///
/// A binding is modelled rather than the whole policy on purpose: a policy is
/// shared with principals outside the forma - GCP's own service agents write to
/// it - and declaring the whole policy would delete their bindings on every
/// apply.
///
/// All fields are createOnly: a change plans a replace.
module gcp.pubsub.subscriptionIamMember

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::PubSub::SubscriptionIamMember"

@gcp.ResourceHint {
    type = module.type
    identifier = "subscription"
}
open class SubscriptionIamMember extends formae.Resource {
    /// Target subscription: its short name (resolved against the target's project) or
    /// a full "projects/{p}/subscriptions/{name}" path. Reference a Subscription resource's
    /// resolvable to order creation.
    @gcp.FieldHint { createOnly = true }
    subscription: (String|formae.Resolvable)

    /// Project of the subscription. Defaults to the target's project when omitted.
    @gcp.FieldHint { createOnly = true; hasProviderDefault = true }
    project: String?

    /// IAM role, e.g. "roles/pubsub.publisher".
    @gcp.FieldHint { createOnly = true }
    role: String

    /// IAM member, e.g. "serviceAccount:x@y.iam.gserviceaccount.com".
    @gcp.FieldHint { createOnly = true }
    member: String
}
