/// GCP Serverless VPC Access Connector
///
/// A connector that lets serverless environments reach resources in a VPC
/// network via internal IP. Location-scoped; create and delete are
/// long-running operations.
module gcp.vpcaccess.connector

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Vpcaccess::Connector"

open class ConnectorResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: ConnectorResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class Connector extends formae.Resource {
    hidden parent = this

    /// Short connector id (e.g. "my-connector"). Immutable.
    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    /// Name of the VPC network to connect to (e.g. "default"). Immutable.
    @gcp.FieldHint {
        createOnly = true
    }
    network: String

    /// Internal address range in RFC 4632 notation (e.g. "10.8.0.0/28").
    /// Immutable.
    @gcp.FieldHint {
        createOnly = true
    }
    ipCidrRange: String

    /// Machine type of the underlying VM instances. GCP defaults to "e2-micro"
    /// when unset.
    @gcp.FieldHint {
        createOnly = true
        hasProviderDefault = true
    }
    machineType: String?

    /// Minimum throughput in Mbps. GCP populates a default when unset.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    minThroughput: Int?

    /// Maximum throughput in Mbps. GCP populates a default when unset.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    maxThroughput: Int?

    /// Minimum number of instances in the autoscaling group. GCP populates a
    /// default when unset.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    minInstances: Int?

    /// Maximum number of instances in the autoscaling group. GCP populates a
    /// default when unset.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    maxInstances: Int?

    hidden res: ConnectorResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
