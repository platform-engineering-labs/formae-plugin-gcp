module gcp.container.cluster

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Container::Cluster"

// Release Channel types
typealias ReleaseChannelChannel = "UNSPECIFIED"|"RAPID"|"REGULAR"|"STABLE"

// Network types
typealias DatapathProvider = "DATAPATH_PROVIDER_UNSPECIFIED"|"LEGACY_DATAPATH"|"ADVANCED_DATAPATH"

typealias PrivateIpv6GoogleAccess = "PRIVATE_IPV6_GOOGLE_ACCESS_UNSPECIFIED"|"INHERIT_FROM_SUBNETWORK"|"OUTBOUND"|"BIDIRECTIONAL"

typealias ClusterDns = "PROVIDER_UNSPECIFIED"|"PLATFORM_DEFAULT"|"CLOUD_DNS"|"KUBE_DNS"

typealias ClusterDnsScope = "DNS_SCOPE_UNSPECIFIED"|"CLUSTER_SCOPE"|"VPC_SCOPE"

typealias GatewayApiChannel = "CHANNEL_DISABLED"|"CHANNEL_EXPERIMENTAL"|"CHANNEL_STANDARD"

typealias InTransitEncryptionConfig = "IN_TRANSIT_ENCRYPTION_CONFIG_UNSPECIFIED"|"IN_TRANSIT_ENCRYPTION_DISABLED"|"IN_TRANSIT_ENCRYPTION_INTER_NODE_TRANSPARENT"

typealias NetworkTier = "PREMIUM"|"STANDARD" | "NETWORK_TIER_DEFAULT"

// IP Allocation Policy
typealias StackType = "STACK_TYPE_UNSPECIFIED"|"IPV4"|"IPV4_IPV6"

// Autoscaling
typealias AutoscalingProfile = "PROFILE_UNSPECIFIED"|"OPTIMIZE_UTILIZATION"|"BALANCED"

// Database Encryption
typealias DatabaseEncryptionState = "UNKNOWN"|"ENCRYPTED"|"DECRYPTED"

// Workload Identity
typealias WorkloadMetadataMode = "MODE_UNSPECIFIED"|"GCE_METADATA"|"GKE_METADATA"

// Enterprise Config
typealias ClusterTier = "CLUSTER_TIER_UNSPECIFIED"|"STANDARD"|"ENTERPRISE"

// Security Posture
typealias SecurityPostureMode = "MODE_UNSPECIFIED"|"DISABLED"|"BASIC"|"ENTERPRISE"

typealias VulnerabilityMode = "VULNERABILITY_MODE_UNSPECIFIED"|"VULNERABILITY_DISABLED"|"VULNERABILITY_BASIC"|"VULNERABILITY_ENTERPRISE"

// Node Config
typealias DiskType = "DISK_TYPE_UNSPECIFIED"|"PD_STANDARD"|"PD_SSD"|"PD_BALANCED"|"pd-standard"|"pd-ssd"|"pd-balanced"

typealias ImageType = "IMAGE_TYPE_UNSPECIFIED"|"COS"|"COS_CONTAINERD"|"UBUNTU_CONTAINERD"|"WINDOWS_SAC"|"WINDOWS_LTSC"

// Maintenance Policy
typealias MaintenanceInterval = "MAINTENANCE_INTERVAL_UNSPECIFIED"|"AS_NEEDED"|"PERIODIC"

// Binary Authorization
typealias BinaryAuthorizationEvaluationMode = "EVALUATION_MODE_UNSPECIFIED"|"DISABLED"|"PROJECT_SINGLETON_POLICY_ENFORCE"

@gcp.SubResourceHint
open class ReleaseChannel extends formae.SubResource {
    @gcp.FieldHint
    channel: ReleaseChannelChannel
}

