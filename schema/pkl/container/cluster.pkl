open class ClusterResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: ClusterResolvable = (this) {
        property = "Id"
    }

    hidden selfLink: ClusterResolvable = (this) {
        property = "SelfLink"
    }

    hidden name: ClusterResolvable = (this) {
        property = "Name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "Name"
}
open class Cluster extends formae.Resource {
    hidden parent = this

    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    description: String?

    @gcp.FieldHint {
        createOnly = true
    }
    initialNodeCount: Int?

    @gcp.FieldHint
    nodeConfig: NodeConfig?

    @gcp.FieldHint
    masterAuth: MasterAuth?

    loggingService: String?

    monitoringService: String?

    @gcp.FieldHint {
        createOnly = true
    }
    network: String|formae.Resolvable

    @gcp.FieldHint {
        createOnly = true
    }
    subnetwork: String|formae.Resolvable

    clusterIpv4Cidr: String?

    @gcp.FieldHint
    addonsConfig: AddonsConfig?

    nodePools: Listing<NodePool>?

    @gcp.FieldHint {
        createOnly = true
    }
    locations: Listing<String>?

    enableKubernetesAlpha: Boolean?

    resourceLabels: Mapping<String, String>?

    labelFingerprint: String?

    legacyAbac: Mapping<String, Boolean>?

    @gcp.FieldHint
    networkPolicy: NetworkPolicy?

    @gcp.FieldHint
    ipAllocationPolicy: IPAllocationPolicy?

    @gcp.FieldHint
    masterAuthorizedNetworksConfig: MasterAuthorizedNetworksConfig?

    @gcp.FieldHint
    maintenancePolicy: MaintenancePolicy?

    @gcp.FieldHint
    binaryAuthorization: BinaryAuthorization?

    @gcp.FieldHint
    autoscaling: ClusterAutoscaling?

    @gcp.FieldHint
    networkConfig: NetworkConfig?

    defaultMaxPodsConstraint: MaxPodsConstraint?

    @gcp.FieldHint
    privateClusterConfig: PrivateClusterConfig?

    @gcp.FieldHint
    databaseEncryption: DatabaseEncryption?

    @gcp.FieldHint
    verticalPodAutoscaling: VerticalPodAutoscaling?

    shieldedNodes: Mapping<String, Boolean>?

    @gcp.FieldHint {
        createOnly = true
    }
    releaseChannel: ReleaseChannel?

    @gcp.FieldHint
    workloadIdentityConfig: WorkloadIdentityConfig?

    @gcp.FieldHint
    notificationConfig: NotificationConfig?

    @gcp.FieldHint
    confidentialNodes: ConfidentialNodes?

    @gcp.FieldHint
    loggingConfig: LoggingConfig?

    @gcp.FieldHint
    monitoringConfig: MonitoringConfig?

    @gcp.FieldHint {
        createOnly = true
    }
    location: formae.Resolvable|String?

    @gcp.FieldHint {
        createOnly = true
    }
    autopilot: Autopilot?

    @gcp.FieldHint
    enterpriseConfig: EnterpriseConfig?

    @gcp.FieldHint
    securityPostureConfig: SecurityPostureConfig?

    @gcp.FieldHint
    fleet: Fleet?

    @gcp.FieldHint
    costManagementConfig: CostManagementConfig?

    initialClusterVersion: String?

    @gcp.FieldHint {
        persist = false
    }
    currentMasterVersion: String?

    @gcp.FieldHint {
        persist = false
    }
    currentNodeVersion: String?

    @gcp.FieldHint {
        persist = false
    }
    createTime: String?

    @gcp.FieldHint {
        persist = false
    }
    status: String?

    @gcp.FieldHint {
        persist = false
    }
    statusMessage: String?

    @gcp.FieldHint {
        persist = false
    }
    nodeIpv4CidrSize: Int?

    @gcp.FieldHint {
        persist = false
    }
    servicesIpv4Cidr: String?

    @gcp.FieldHint {
        persist = false
    }
    instanceGroupUrls: Listing<String>?

    @gcp.FieldHint {
        persist = false
    }
    currentNodeCount: Int?

    @gcp.FieldHint {
        persist = false
    }
    expireTime: String?

    @gcp.FieldHint {
        persist = false
    }
    zone: String?

    @gcp.FieldHint {
        persist = false
    }
    endpoint: String?

    @gcp.FieldHint {
        persist = false
    }
    selfLink: String?

    @gcp.FieldHint {
        createOnly = true
    }
    params: Params?

    hidden res: ClusterResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}