/// GCP Network Services TcpRoute
///
/// Layer-4 TCP routing for a Cloud Service Mesh: match a connection on its
/// destination CIDR and port, then either forward it to a backend service or
/// hand it straight through to the address it was originally headed for.
///
/// The passthrough action — `originalDestination` — is what lets a TcpRoute be
/// declared with no backend at all. It comes with a constraint worth stating,
/// because the API only reveals it as a 400: passthrough is allowed only when
/// at least one of the rule's matches covers everything. A match on
/// "10.0.0.1/32" is refused with "original_destination is allowed when at least
/// one address match is */0"; a match on "0.0.0.0/0" is accepted.
///
/// Global; create, update and delete are long-running operations.
module gcp.networkservices.tcpRoute

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::NetworkServices::TcpRoute"

/// The predicate a rule matches connections on. Both halves are required.
@gcp.SubResourceHint
open class TcpRouteMatch extends formae.SubResource {
    /// The destination address, in CIDR form, e.g. "10.0.0.0/24". Use
    /// "0.0.0.0/0" to match everything — which `originalDestination` requires.
    @gcp.FieldHint
    address: String

    /// The destination port, as a string, e.g. "8080" — the API models ports as
    /// strings here and echoes them back that way.
    @gcp.FieldHint
    port: String
}

/// One backend a rule forwards to, and its share of the traffic.
@gcp.SubResourceHint
open class TcpRouteDestination extends formae.SubResource {
    /// The `GCP::Compute::BackendService` to forward to. Echoed back exactly as
    /// given, so a backend service's `selfLink` resolvable round-trips without
    /// translation.
    @gcp.FieldHint
    serviceName: (String|formae.Resolvable)?

    @gcp.FieldHint
    weight: Int?
}

/// What to do with a matched connection. Required on every rule. Give
/// `destinations` or `originalDestination`, not both.
@gcp.SubResourceHint
open class TcpRouteAction extends formae.SubResource {
    @gcp.FieldHint
    destinations: Listing<TcpRouteDestination>?

    /// Forward the connection to the address and port it was originally
    /// headed for, naming no backend. Requires a `*/0` address match — see the
    /// module comment.
    @gcp.FieldHint
    originalDestination: Boolean?

    /// A duration, e.g. "30s".
    @gcp.FieldHint
    idleTimeout: String?
}

/// One rule: a set of predicates and the action to take when one matches.
@gcp.SubResourceHint
open class TcpRouteRule extends formae.SubResource {
    /// Omit this and the rule matches everything.
    @gcp.FieldHint
    matches: Listing<TcpRouteMatch>?

    /// Required — a rule with no action is refused outright.
    @gcp.FieldHint
    action: TcpRouteAction
}

open class TcpRouteResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: TcpRouteResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class TcpRoute extends formae.Resource {
    hidden parent = this

    /// Short id (e.g. "my-tcp-route"). Immutable — it is the resource path, and
    /// travels as ?tcpRouteId= on create.
    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    /// The routing rules, in order. At least one is required.
    ///
    /// Required on every PATCH as well as on create: this API validates the
    /// resource from the request body alone, and a patch that omits them is
    /// refused with "must specify at-least one RouteRule" even though the
    /// stored route has some. Being non-optional here is what guarantees they
    /// always ride along.
    @gcp.FieldHint
    rules: Listing<TcpRouteRule>

    /// The `GCP::NetworkServices::Mesh` scopes this route attaches to.
    ///
    /// Declared as resolvables so a forma can pass a mesh directly and have
    /// formae order the creates. A resolvable yields the short name and the
    /// short form is refused, so the plugin expands each entry to
    /// `projects/{p}/locations/global/meshes/{name}` on the way out and
    /// shortens it on the way back.
    ///
    /// The sibling `gateways` field is deliberately absent: a gateway bills, so
    /// its round trip could not be verified.
    @gcp.FieldHint
    meshes: Listing<String|formae.Resolvable>?

    /// An optional description. Absent rather than empty when never set, so no
    /// provider default.
    @gcp.FieldHint
    description: String?

    /// Optional labels in key-value pair format. See mesh.pkl for the
    /// label-clearing behaviour this API's PATCH has.
    @gcp.FieldHint
    labels: Mapping<String, String>?

    hidden res: TcpRouteResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
