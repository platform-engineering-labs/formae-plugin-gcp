/// GCP Network Services TlsRoute
///
/// TLS routing for a Cloud Service Mesh, by SNI and ALPN, without terminating
/// the connection — the proxy reads the handshake to pick a backend and then
/// passes the bytes through.
///
/// Alone among the four route kinds this one has no destination-free action.
/// There is no `originalDestination` here, and a rule whose action names no
/// destination is refused with "at least one destination or original_destination
/// must be set", so a TlsRoute always needs a backend service to point at. That
/// is still free: a `GCP::Compute::BackendService` with no backends attached
/// provisions nothing, and needs only a `GCP::Compute::HealthCheck`, which is
/// free as well.
///
/// Global; create, update and delete are long-running operations.
module gcp.networkservices.tlsRoute

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::NetworkServices::TlsRoute"

/// The predicate a rule matches handshakes on. Give at least one of the two.
@gcp.SubResourceHint
open class TlsRouteMatch extends formae.SubResource {
    /// SNI hostnames to match, e.g. "api.example.com". Wildcards are allowed.
    @gcp.FieldHint
    sniHost: Listing<String>?

    /// ALPN protocol identifiers to match, e.g. "h2", "http/1.1".
    @gcp.FieldHint
    alpn: Listing<String>?
}

/// One backend a rule forwards to, and its share of the traffic.
@gcp.SubResourceHint
open class TlsRouteDestination extends formae.SubResource {
    /// The `GCP::Compute::BackendService` to forward to.
    ///
    /// The API echoes this back byte-for-byte in whatever form it was given —
    /// verified live with both a full `https://www.googleapis.com/compute/v1/…`
    /// URL and a bare `projects/{p}/global/backendServices/{name}` path — so
    /// passing a backend service's `selfLink` resolvable directly round-trips
    /// exactly and needs no translation, unlike `meshes` below.
    @gcp.FieldHint
    serviceName: (String|formae.Resolvable)?

    @gcp.FieldHint
    weight: Int?
}

/// What to do with a matched connection. Required on every rule, and
/// `destinations` is required within it.
@gcp.SubResourceHint
open class TlsRouteAction extends formae.SubResource {
    @gcp.FieldHint
    destinations: Listing<TlsRouteDestination>

    /// A duration, e.g. "30s".
    @gcp.FieldHint
    idleTimeout: String?
}

/// One rule: the handshake predicates and the action to take when one matches.
/// Both halves are required here — unlike the other route kinds, a TlsRoute
/// rule may not omit its matches.
@gcp.SubResourceHint
open class TlsRouteRule extends formae.SubResource {
    @gcp.FieldHint
    matches: Listing<TlsRouteMatch>

    @gcp.FieldHint
    action: TlsRouteAction
}

open class TlsRouteResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: TlsRouteResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class TlsRoute extends formae.Resource {
    hidden parent = this

    /// Short id (e.g. "my-tls-route"). Immutable — it is the resource path, and
    /// travels as ?tlsRouteId= on create.
    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    /// The routing rules, in order. At least one is required.
    ///
    /// Required on every PATCH as well as on create: this API validates the
    /// resource from the request body alone rather than merging it over stored
    /// state, so being non-optional here is what guarantees the rules always
    /// ride along and the patch is accepted.
    @gcp.FieldHint
    rules: Listing<TlsRouteRule>

    /// The `GCP::NetworkServices::Mesh` scopes this route attaches to.
    ///
    /// Declared as resolvables so a forma can pass a mesh directly and have
    /// formae order the creates. A resolvable yields the short name and the
    /// short form is refused, so the plugin expands each entry to
    /// `projects/{p}/locations/global/meshes/{name}` on the way out and
    /// shortens it on the way back.
    ///
    /// The siblings `gateways` and `targetProxies` are deliberately absent: a
    /// gateway allocates Envoy proxies and so bills, and a target proxy belongs
    /// to a load balancer front end, so neither round trip could be verified.
    @gcp.FieldHint
    meshes: Listing<String|formae.Resolvable>?

    /// An optional description. Absent rather than empty when never set, so no
    /// provider default.
    @gcp.FieldHint
    description: String?

    /// Optional labels in key-value pair format. See mesh.pkl for the
    /// label-clearing behaviour this API's PATCH has.
    @gcp.FieldHint
    labels: Mapping<String, String>?

    hidden res: TlsRouteResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
