/// GCP Service Directory Endpoint
///
/// One address and port a service answers on. Endpoints are what a resolve call
/// actually returns, so a service without them resolves to nothing.
///
/// Endpoints live two collections deep
/// (`.../namespaces/{namespace}/services/{service}/endpoints/{endpoint}`).
module gcp.servicedirectory.endpoint

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::ServiceDirectory::Endpoint"

open class EndpointResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: EndpointResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class Endpoint extends formae.Resource {
    hidden parent = this

    /// Short endpoint id (e.g. "my-endpoint"). Immutable.
    @gcp.FieldHint { createOnly = true }
    name: String

    /// Short id of the owning namespace. A path component, not a body field.
    @gcp.FieldHint { createOnly = true }
    namespace: (String|formae.Resolvable)

    /// Short id of the owning service. A path component, not a body field —
    /// pass `svc.res.name` so formae creates the service first.
    @gcp.FieldHint { createOnly = true }
    service: (String|formae.Resolvable)

    /// IPv4 or IPv6 address the service answers on.
    @gcp.FieldHint
    address: String?

    /// Port the service answers on (1-65535).
    @gcp.FieldHint
    port: Int?

    /// Free-form annotations. Keys beginning with "cloud.google.com/" are
    /// reserved by GCP.
    @gcp.FieldHint
    annotations: Mapping<String, String>?

    /// VPC network the address belongs to, as
    /// `projects/{project number}/locations/global/networks/{network}`.
    /// Immutable, and written with the project *number* rather than its id.
    @gcp.FieldHint { createOnly = true }
    network: String?

    hidden res: EndpointResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
