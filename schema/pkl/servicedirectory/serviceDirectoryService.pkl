/// GCP Service Directory Service
///
/// A named service inside a namespace. It carries annotations describing the
/// service and holds the endpoints that say where it actually answers.
module gcp.servicedirectory.serviceDirectoryService

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::ServiceDirectory::Service"

open class ServiceResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: ServiceResolvable = (this) {
        property = "name"
    }

    /// A reference to the service's namespace. An endpoint is addressed by both
    /// its namespace and its service, and reads the namespace from here so that
    /// naming one reference orders it after the service too.
    hidden namespace: ServiceResolvable = (this) {
        property = "namespace"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
    parent = "GCP::ServiceDirectory::Namespace"
    listParam = new Listing<formae.ListProperty> {
        new formae.ListProperty { parentProperty = "name" listParameter = "namespace"
        }
    }.toList()
}
open class Service extends formae.Resource {
    hidden parent = this

    /// Short service id, unique within the namespace. Immutable.
    @gcp.FieldHint { createOnly = true }
    name: String

    /// The namespace holding the service. A short namespace name or a Namespace
    /// reference.
    @gcp.FieldHint { createOnly = true }
    namespace: (String|formae.Resolvable)

    /// The project holding the service.
    @gcp.FieldHint { createOnly = true }
    project: (String|formae.Resolvable)?

    @gcp.FieldHint
    annotations: Mapping<String, String>?

    /// Server-set concurrency token.
    @gcp.FieldHint { hasProviderDefault = true }
    uid: String?

    hidden res: ServiceResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
