/// GCP Compute HttpsHealthCheck (global, legacy)
///
/// The legacy HTTPS health check. Like its HTTP sibling it exists because
/// `targetPool.healthChecks` accepts only the legacy checks, not the modern
/// `healthCheck`. Use it when the backends terminate TLS and you are wiring a
/// network load balancer through a target pool.
module gcp.compute.httpsHealthCheck

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Compute::HttpsHealthCheck"

open class HttpsHealthCheckResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: HttpsHealthCheckResolvable = (this) {
        property = "id"
    }

    hidden selfLink: HttpsHealthCheckResolvable = (this) {
        property = "selfLink"
    }

    hidden name: HttpsHealthCheckResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class HttpsHealthCheck extends formae.Resource {
    hidden parent = this

    @gcp.FieldHint { createOnly = true }
    name: String

    @gcp.FieldHint
    description: String?

    /// TCP port to probe. GCP defaults to 443.
    @gcp.FieldHint { hasProviderDefault = true }
    port: Int?

    /// Path to request. GCP defaults to "/".
    @gcp.FieldHint { hasProviderDefault = true }
    requestPath: String?

    /// Host header to send. GCP returns an empty string when unset, in which
    /// case the backend's IP is used.
    @gcp.FieldHint { hasProviderDefault = true }
    host: String?

    /// Seconds between probes. GCP defaults to 5.
    @gcp.FieldHint { hasProviderDefault = true }
    checkIntervalSec: Int?

    /// Seconds to wait for a response. Must not exceed `checkIntervalSec`.
    @gcp.FieldHint { hasProviderDefault = true }
    timeoutSec: Int?

    /// Consecutive successes before a backend is called healthy.
    @gcp.FieldHint { hasProviderDefault = true }
    healthyThreshold: Int?

    /// Consecutive failures before a backend is called unhealthy.
    @gcp.FieldHint { hasProviderDefault = true }
    unhealthyThreshold: Int?

    hidden res: HttpsHealthCheckResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
