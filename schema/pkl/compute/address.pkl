module gcp.compute.address

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Compute::Address"

typealias AddressType = "INTERNAL"|"EXTERNAL"

typealias IpVersion = "IPV4"|"IPV6"

typealias Ipv6EndpointType = "VM"|"NETLB"

typealias NetworkTier = "PREMIUM"|"STANDARD"

typealias Purpose = "GCE_ENDPOINT"|"SHARED_LOADBALANCER_VIP"|"VPC_PEERING"|"IPSEC_INTERCONNECT"|"PRIVATE_SERVICE_CONNECT"



open class AddressResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden address: AddressResolvable = (this) {
        property = "address"
    }

    hidden selfLink: AddressResolvable = (this) {
        property = "selfLink"
    }

    hidden name: AddressResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class Address extends formae.Resource {
    hidden parent = this

    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    @gcp.FieldHint {
        createOnly = true
    }
    address: String?

    @gcp.FieldHint {
        createOnly = true
    }
    addressType: AddressType?

    @gcp.FieldHint {
        createOnly = true
    }
    description: String?

    @gcp.FieldHint {
        createOnly = true
    }
    ipVersion: IpVersion?

    @gcp.FieldHint {
        createOnly = true
    }
    ipv6EndpointType: Ipv6EndpointType?

    labels: Mapping<String, String>?

    @gcp.FieldHint {
        createOnly = true
    }
    network: (String|formae.Resolvable)?

    /// GCP fills this in with the only tier valid for the address type when unset.
    @gcp.FieldHint {
        createOnly = true
        hasProviderDefault = true
    }
    networkTier: NetworkTier?

    @gcp.FieldHint {
        createOnly = true
    }
    prefixLength: Int?

    /// GCP infers this from the address type when unset.
    @gcp.FieldHint {
        createOnly = true
        hasProviderDefault = true
    }
    purpose: Purpose?

    @gcp.FieldHint {
        createOnly = true
    }
    region: gcp.Region

    @gcp.FieldHint {
        createOnly = true
    }
    subnetwork: (String|formae.Resolvable)?

    /// Labels as the API reports them, including any applied outside the forma. Set by the API.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    effectiveLabels: Mapping<String, String>?

    /// Hash of the current labels, used for optimistic locking on setLabels. Set by the API.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    labelFingerprint: String?

    /// Labels the API reports for Terraform interoperability. Set by the API.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    terraformLabels: Mapping<String, String>?

    /// Resources currently using this address. Set by the API.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    users: Listing<String>?

    /// Server-assigned URL for this resource. Set by the API.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    selfLink: String?

    hidden res: AddressResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
