module gcp.compute.routerNat

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Compute::RouterNat"

typealias NatIpAllocateOption = "AUTO_ONLY"|"MANUAL_ONLY"

typealias SourceSubnetworkIpRangesToNat =
  "ALL_SUBNETWORKS_ALL_IP_RANGES"
  |"ALL_SUBNETWORKS_ALL_PRIMARY_IP_RANGES"
  |"LIST_OF_SUBNETWORKS"

typealias NatType = "PUBLIC"|"PRIVATE"

typealias EndpointType = "ENDPOINT_TYPE_VM"|"ENDPOINT_TYPE_SWG"|"ENDPOINT_TYPE_MANAGED_PROXY_LB"

typealias AutoNetworkTier = "PREMIUM"|"STANDARD"

typealias LogFilter = "ERRORS_ONLY"|"TRANSLATIONS_ONLY"|"ALL"

typealias SourceIpRange = "ALL_IP_RANGES"|"LIST_OF_SECONDARY_IP_RANGES"|"PRIMARY_IP_RANGE"

@gcp.SubResourceHint
open class SubnetworkToNat extends formae.SubResource {
    name: String|formae.Resolvable

    sourceIpRangesToNat: Listing<SourceIpRange>

    secondaryIpRangeNames: Listing<String>?
}

@gcp.SubResourceHint
open class LogConfig extends formae.SubResource {
    enable: Boolean

    filter: LogFilter
}

open class RouterNatResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: RouterNatResolvable = (this) {
        property = "name"
    }

    hidden selfLink: RouterNatResolvable = (this) {
        property = "selfLink"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "Name"
}
open class RouterNat extends formae.Resource {
    hidden parent = this

    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    @gcp.FieldHint {
        createOnly = true
    }
    router: String|formae.Resolvable

    @gcp.FieldHint {
        createOnly = true
    }
    region: gcp.Region

    @gcp.FieldHint
    natIpAllocateOption: NatIpAllocateOption

    @gcp.FieldHint
    sourceSubnetworkIpRangesToNat: SourceSubnetworkIpRangesToNat

    @gcp.FieldHint
    natIps: Listing<String|formae.Resolvable>?

    @gcp.FieldHint
    drainNatIps: Listing<String|formae.Resolvable>?

    @gcp.FieldHint
    subnetworks: Listing<SubnetworkToNat>?

    @gcp.FieldHint
    minPortsPerVm: Int?

    @gcp.FieldHint
    maxPortsPerVm: Int?

    @gcp.FieldHint
    udpIdleTimeoutSec: Int?

    @gcp.FieldHint
    icmpIdleTimeoutSec: Int?

    @gcp.FieldHint
    tcpEstablishedIdleTimeoutSec: Int?

    @gcp.FieldHint
    tcpTransitoryIdleTimeoutSec: Int?

    @gcp.FieldHint
    tcpTimeWaitTimeoutSec: Int?

    @gcp.FieldHint
    logConfig: LogConfig?

    @gcp.FieldHint { hasProviderDefault = true }
    enableEndpointIndependentMapping: Boolean?

    @gcp.FieldHint
    enableDynamicPortAllocation: Boolean?

    @gcp.FieldHint {
        createOnly = true
        hasProviderDefault = true
    }
    `type`: NatType?

    @gcp.FieldHint { hasProviderDefault = true }
    autoNetworkTier: AutoNetworkTier?

    @gcp.FieldHint {
        createOnly = true
        hasProviderDefault = true
    }
    endpointTypes: Listing<EndpointType>?

    hidden res: RouterNatResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
