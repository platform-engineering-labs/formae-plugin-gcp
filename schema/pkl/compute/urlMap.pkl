open class UrlMapResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: UrlMapResolvable = (this) {
        property = "id"
    }

    hidden selfLink: UrlMapResolvable = (this) {
        property = "selfLink"
    }

    hidden name: UrlMapResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class UrlMap extends formae.Resource {
    hidden parent = this

    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    @gcp.FieldHint
    description: String?

    @gcp.FieldHint
    defaultService: (String|formae.Resolvable)?

    @gcp.FieldHint
    defaultRouteAction: RouteAction?

    @gcp.FieldHint
    defaultUrlRedirect: UrlRedirect?

    @gcp.FieldHint
    hostRules: Listing<HostRule>?

    @gcp.FieldHint
    pathMatchers: Listing<PathMatcher>?

    @gcp.FieldHint
    headerAction: HeaderAction?

    @gcp.FieldHint {
        persist = false
    }
    fingerprint: String?

    hidden res: UrlMapResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
