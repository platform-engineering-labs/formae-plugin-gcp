/// GCP Compute RegionNetworkFirewallPolicyAssociation
///
/// Attaches a regional network firewall policy to a VPC network. A policy with rules but
/// no association is inert — the association is what puts it in the data path,
/// so this is what makes `RegionNetworkFirewallPolicy` do anything. The network
/// itself is global; only the policy is regional.
///
/// Like the policy's rules, an association is not a REST resource but a set of
/// verbs on the policy — addAssociation, getAssociation, removeAssociation — so
/// this is a hand-written provisioner.
///
/// ponytail: nothing is updatable — an association is a (policy, network) pair,
/// so a change replaces it.
module gcp.compute.regionNetworkFirewallPolicyAssociation

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Compute::RegionNetworkFirewallPolicyAssociation"

open class RegionNetworkFirewallPolicyAssociationResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: RegionNetworkFirewallPolicyAssociationResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class RegionNetworkFirewallPolicyAssociation extends formae.Resource {
    hidden parent = this

    /// Name for the association itself, unique within the policy.
    @gcp.FieldHint { createOnly = true }
    name: String

    /// Id of the owning policy. A path component, not part of the attach body —
    /// pass `policy.res.name` so formae creates the policy first.
    @gcp.FieldHint { createOnly = true }
    firewallPolicy: (String|formae.Resolvable)

    /// Region of the owning policy. Also a path component, so it never travels
    /// in the attach body.
    @gcp.FieldHint { createOnly = true }
    region: String

    /// URL of the VPC network to attach the policy to. Pass
    /// `network.res.selfLink` so formae creates the network first.
    @gcp.FieldHint { createOnly = true }
    attachmentTarget: (String|formae.Resolvable)

    hidden res: RegionNetworkFirewallPolicyAssociationResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
