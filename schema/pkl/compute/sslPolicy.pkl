/// GCP Compute SslPolicy (global)
///
/// The TLS floor a target HTTPS/SSL proxy enforces: minimum protocol version
/// plus a cipher profile. Attach it from `targetHttpsProxy.sslPolicy` or
/// `targetSslProxy.sslPolicy` — without one, a proxy accepts Google's default
/// (permissive) set.
///
/// Updates are in-place: `sslPolicies.patch` requires the current
/// `fingerprint`, which the generic engine supplies through optimistic locking.
module gcp.compute.sslPolicy

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Compute::SslPolicy"

/// COMPATIBLE and MODERN and RESTRICTED are Google-curated cipher sets, in
/// decreasing permissiveness. CUSTOM takes an explicit `customFeatures` list.
typealias SslPolicyProfile = "COMPATIBLE"|"MODERN"|"RESTRICTED"|"CUSTOM"

typealias MinTlsVersion = "TLS_1_0"|"TLS_1_1"|"TLS_1_2"

open class SslPolicyResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: SslPolicyResolvable = (this) {
        property = "id"
    }

    hidden selfLink: SslPolicyResolvable = (this) {
        property = "selfLink"
    }

    hidden name: SslPolicyResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class SslPolicy extends formae.Resource {
    hidden parent = this

    @gcp.FieldHint { createOnly = true }
    name: String

    @gcp.FieldHint
    description: String?

    @gcp.FieldHint { hasProviderDefault = true }
    profile: SslPolicyProfile?

    @gcp.FieldHint { hasProviderDefault = true }
    minTlsVersion: MinTlsVersion?

    /// Cipher suites to allow. Only valid when `profile` is "CUSTOM".
    @gcp.FieldHint
    customFeatures: Listing<String>?

    hidden res: SslPolicyResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
