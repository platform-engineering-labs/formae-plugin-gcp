module gcp.compute.regionTargetTcpProxy

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Compute::RegionTargetTcpProxy"

typealias ProxyHeader = "NONE"|"PROXY_V1"

open class RegionTargetTcpProxyResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: RegionTargetTcpProxyResolvable = (this) {
        property = "id"
    }

    hidden selfLink: RegionTargetTcpProxyResolvable = (this) {
        property = "selfLink"
    }

    hidden name: RegionTargetTcpProxyResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class RegionTargetTcpProxy extends formae.Resource {
    hidden parent = this

    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    @gcp.FieldHint {
        createOnly = true
    }
    region: gcp.Region

    @gcp.FieldHint {
        createOnly = true
    }
    description: String?

    @gcp.FieldHint { edgeKind = "attachesTo" }
    service: (String|formae.Resolvable)

    @gcp.FieldHint {
        createOnly = true
    }
    proxyHeader: ProxyHeader?

    @gcp.FieldHint {
        createOnly = true
    }
    proxyBind: Boolean?

    hidden res: RegionTargetTcpProxyResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
