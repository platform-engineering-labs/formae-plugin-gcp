/// GCP Compute InstanceGroup (zonal, unmanaged)
///
/// An unmanaged instance group is a named, zonal collection of VMs that a
/// load balancer's backend service can target. This resource manages the group
/// object, its named ports, and its VM membership. Membership is reconciled via
/// the addInstances / removeInstances verbs and named ports via setNamedPorts.
module gcp.compute.instanceGroup

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Compute::InstanceGroup"

/// A name -> port mapping the backend service references by port name.
@gcp.SubResourceHint
open class NamedPort extends formae.SubResource {
    @gcp.FieldHint
    name: String

    @gcp.FieldHint
    port: Int
}

open class InstanceGroupResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: InstanceGroupResolvable = (this) {
        property = "id"
    }

    hidden selfLink: InstanceGroupResolvable = (this) {
        property = "selfLink"
    }

    hidden name: InstanceGroupResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class InstanceGroup extends formae.Resource {
    hidden parent = this

    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    @gcp.FieldHint {
        createOnly = true
    }
    description: String?

    @gcp.FieldHint {
        createOnly = true
    }
    zone: String

    @gcp.FieldHint {
        createOnly = true
    }
    network: (String|formae.Resolvable)?

    @gcp.FieldHint {
        createOnly = true
    }
    subnetwork: (String|formae.Resolvable)?

    /// Named ports the backend service can reference. Mutable via setNamedPorts.
    @gcp.FieldHint
    namedPorts: Listing<NamedPort>?

    /// VM members of this group, as instance self-links (or Instance resolvables).
    /// Reconciled via addInstances / removeInstances.
    @gcp.FieldHint
    instances: Listing<String|formae.Resolvable>?

    hidden res: InstanceGroupResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
