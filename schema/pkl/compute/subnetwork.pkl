module gcp.compute.subnetwork

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Compute::Subnetwork"

typealias Role = "ACTIVE"|"BACKUP"

typealias StackType = "IPV4_ONLY"|"IPV4_IPV6"|"IPV6_ONLY"

typealias Ipv6AccessType = "EXTERNAL"|"INTERNAL"

typealias Ipv6GceEndpoint = "VM_AND_FR"|"VM_ONLY"

typealias AggregationInterval = "INTERVAL_5_SEC"|"INTERVAL_30_SEC"|"INTERVAL_1_MIN"|"INTERVAL_5_MIN"|"INTERVAL_10_MIN"|"INTERVAL_15_MIN"

typealias Metadata = "EXCLUDE_ALL_METADATA"|"INCLUDE_ALL_METADATA"|"CUSTOM_METADATA"



@gcp.SubResourceHint
open class LogConfig extends formae.SubResource {
    @gcp.FieldHint
    aggregationInterval: AggregationInterval?

    flowSampling: Number?

    @gcp.FieldHint
    metadata: Metadata?

    metadataFields: Listing<String>?

    filterExpr: String?
}

@gcp.SubResourceHint
open class Params extends formae.SubResource {
    @gcp.FieldHint {
        createOnly = true
    }
    resourceManagerTags: Mapping<String, String>?
}

@gcp.SubResourceHint
open class SecondaryIpRange extends formae.SubResource {
    rangeName: String
    ipCidrRange: String
}

open class SubnetworkResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: SubnetworkResolvable = (this) {
        property = "id"
    }

    hidden selfLink: SubnetworkResolvable = (this) {
        property = "selfLink"
    }

    hidden name: SubnetworkResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "subnetworkId"
}
open class Subnetwork extends formae.Resource {
    hidden parent = this

    @gcp.FieldHint {
        createOnly = true
    }
    description: String?

    @gcp.FieldHint {
    }
    subnetworkId: Int?

    @gcp.FieldHint {
        hasProviderDefault = true
    }
    gatewayAddress: String?

    @gcp.FieldHint
    ipCidrRange: String?

    @gcp.FieldHint {
        createOnly = true
    }
    reservedInternalRange: String?

    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    @gcp.FieldHint {
        createOnly = true
    }
    network: String|formae.Resolvable

    @gcp.FieldHint {
        hasProviderDefault = true
    }
    purpose: String?

    @gcp.FieldHint
    role: Role?

    @gcp.FieldHint
    secondaryIpRanges: Listing<SecondaryIpRange>?

    @gcp.FieldHint
    privateIpGoogleAccess: Boolean?

    @gcp.FieldHint {
        hasProviderDefault = true
    }
    privateIpv6GoogleAccess: String?

    @gcp.FieldHint {
        createOnly = true
    }
    region: gcp.Region

    @gcp.FieldHint
    logConfig: LogConfig?

    @gcp.FieldHint {
        hasProviderDefault = true
    }
    stackType: StackType?

    @gcp.FieldHint
    ipv6AccessType: Ipv6AccessType?

    @gcp.FieldHint {
    }
    ipv6CidrRange: String?

    @gcp.FieldHint {
        createOnly = true
    }
    internalIpv6Prefix: String?

    @gcp.FieldHint {
        createOnly = true
    }
    externalIpv6Prefix: String?

    @gcp.FieldHint
    ipCollection: String?

    @gcp.FieldHint {
    }
    ipv6GceEndpoint: Ipv6GceEndpoint?

    @gcp.FieldHint {
        hasProviderDefault = true
    }
    allowSubnetCidrRoutesOverlap: Boolean?

    /// Set by the API.
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    state: String?

    @gcp.FieldHint {
        createOnly = true
    }
    params: Params?

    hidden res: SubnetworkResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}