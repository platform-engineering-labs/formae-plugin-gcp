module gcp.compute.targetSslProxy

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Compute::TargetSslProxy"

typealias ProxyHeader = "NONE"|"PROXY_V1"

open class TargetSslProxyResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: TargetSslProxyResolvable = (this) {
        property = "id"
    }

    hidden selfLink: TargetSslProxyResolvable = (this) {
        property = "selfLink"
    }

    hidden name: TargetSslProxyResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class TargetSslProxy extends formae.Resource {
    hidden parent = this

    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    @gcp.FieldHint
    description: String?

    @gcp.FieldHint { edgeKind = "attachesTo" }
    service: (String|formae.Resolvable)

    @gcp.FieldHint
    sslCertificates: Listing<String|formae.Resolvable>?

    @gcp.FieldHint
    certificateMap: (String|formae.Resolvable)?

    @gcp.FieldHint
    sslPolicy: (String|formae.Resolvable)?

    @gcp.FieldHint
    proxyHeader: ProxyHeader?

    @gcp.FieldHint
    proxyBind: Boolean?

    hidden res: TargetSslProxyResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
