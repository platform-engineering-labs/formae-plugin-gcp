/// GCP Cloud KMS KeyRing
///
/// A logical grouping of CryptoKeys, scoped to a project + location. Created
/// synchronously, and deleted synchronously too - `keyRings.delete` answers with
/// an Operation that is already finished.
///
/// A key ring cannot be updated: the API has no `keyRings.patch`, and the id is
/// the only field there is, so any change replaces the ring.
module gcp.kms.keyRing

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::KMS::KeyRing"

open class KeyRingResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: KeyRingResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class KeyRing extends formae.Resource {
    hidden parent = this

    /// Short KeyRing id (e.g. "my-keyring"). Immutable; sent as ?keyRingId=.
    /// A deleted ring's id can be re-used.
    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    hidden res: KeyRingResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
