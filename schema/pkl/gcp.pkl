module gcp

import "@formae/formae.pkl"

// GCP Regions - Common regions
typealias Region = "us-central1" |
  "us-east1" |
  "us-east4" |
  "us-west1" |
  "us-west2" |
  "us-west3" |
  "us-west4" |
  "us-south1" |
  "northamerica-northeast1" |
  "northamerica-northeast2" |
  "southamerica-east1" |
  "southamerica-west1" |
  "europe-central2" |
  "europe-north1" |
  "europe-north2" |
  "europe-southwest1" |
  "europe-west1" |
  "europe-west2" |
  "europe-west3" |
  "europe-west4" |
  "europe-west6" |
  "europe-west8" |
  "europe-west9" |
  "europe-west10" |
  "europe-west12" |
  "asia-east1" |
  "asia-east2" |
  "asia-northeast1" |
  "asia-northeast2" |
  "asia-northeast3" |
  "asia-south1" |
  "asia-south2" |
  "asia-southeast1" |
  "asia-southeast2" |
  "australia-southeast1" |
  "australia-southeast2" |
  "me-central1" |
  "me-central2" |
  "me-west1" |
  "africa-south1"

// GCP Zones follow pattern: <region>-<a,b,c,d,e,f>
typealias Zone = String

// GCP Location - used by Container (GKE) and CloudRun APIs
// Can be a region (e.g., "us-central1") or zone (e.g., "us-central1-a")
// For GKE, use "-" to target all locations
typealias Location = String

open class Config {
  hidden fixed type: String = "GCP"
  hidden project: String
  hidden region: Region?
  hidden zone: Zone?
  hidden location: Location?

  /// Authentication strategy. Omitting it means the agent's ambient
  /// credentials: GCP_CREDENTIALS_JSON, GCP_CREDENTIALS_FILE, or Application
  /// Default Credentials, exactly as before this block existed.
  ///
  /// Mutable, like the AWS plugin's equivalent: how the agent authenticates is
  /// not where the resources live, so switching a target between ambient
  /// credentials and federation must be a target update rather than a replace
  /// that destroys and recreates every resource on it.
  @formae.ConfigFieldHint { createOnly = false }
  hidden auth: Auth?

  fixed Type: String = type
  fixed Project: String = project
  fixed Region: Region? = region
  fixed Zone: Zone? = zone
  fixed Location: Location? = location
  fixed Auth: Auth? = auth
}

/// How the agent authenticates to this project.
abstract class Auth {
  hidden fixed type: String
  fixed Type: String = type
}

/// Workload Identity Federation: the agent exchanges a short-lived OIDC
/// identity token for Google credentials, with no service account key and no
/// static credential anywhere.
///
/// There is no `DefaultChain` counterpart to this class. The AWS plugin has
/// one because its default chain carries a profile name; GCP's takes no
/// parameters at all, so the variant would be empty and its only meaning
/// would be "what happens when you omit auth" - which omitting auth already
/// says.
class OidcAuth extends Auth {
  fixed type = "Oidc"

  /// The full resource name of the workload identity pool provider that
  /// trusts this installation, as reported by `formae connect gcp`. It is
  /// also the audience of every token minted for this target, so it must be
  /// the canonical spelling: `//iam.googleapis.com/projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>`.
  hidden workloadIdentityProvider: String
  fixed WorkloadIdentityProvider: String = workloadIdentityProvider
}

class FieldHint extends formae.FieldHint {}

class ResourceHint extends formae.ResourceHint {
  hidden outputKeyTransformation: (String) -> String = (it) -> it
}

class SubResourceHint extends formae.SubResourceHint {
  hidden outputKeyTransformation: (String) -> String = (it) -> it
}
