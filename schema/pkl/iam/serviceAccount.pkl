/// GCP IAM Service Account
///
/// A non-human identity used by workloads to authenticate and be authorized.
module gcp.iam.serviceAccount

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::IAM::ServiceAccount"

open class ServiceAccountResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: ServiceAccountResolvable = (this) {
        property = "name"
    }

    hidden email: ServiceAccountResolvable = (this) {
        property = "email"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class ServiceAccount extends formae.Resource {
    hidden parent = this

    /// The accountId (6-30 chars, lowercase letters/digits/hyphens, starts with
    /// a letter). The API derives the email and full resource path from it.
    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    @gcp.FieldHint
    displayName: String?

    @gcp.FieldHint
    description: String?

    hidden res: ServiceAccountResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
