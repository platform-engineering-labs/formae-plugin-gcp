/// GCP Cloud Monitoring Group
///
/// A dynamic collection of monitored resources selected by a filter.
/// Project-scoped; the resource name is assigned by the API on create.
module gcp.monitoring.group

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Monitoring::Group"

open class GroupResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: GroupResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class Group extends formae.Resource {
    hidden parent = this

    /// Server-assigned resource name ("projects/{p}/groups/{id}").
    @gcp.FieldHint {
        hasProviderDefault = true
    }
    name: String?

    @gcp.FieldHint
    displayName: String

    /// Monitoring filter selecting the group's members
    /// (e.g. 'resource.type = "gce_instance"').
    @gcp.FieldHint
    filter: String

    /// Name of a parent group, for building group hierarchies.
    @gcp.FieldHint
    parentName: String?

    @gcp.FieldHint
    isCluster: Boolean?

    hidden res: GroupResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
