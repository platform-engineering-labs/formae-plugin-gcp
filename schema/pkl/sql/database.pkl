/// GCP Cloud SQL Database Instance
///
/// A managed MySQL, PostgreSQL, or SQL Server database instance.
module gcp.sql.database

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::SQL::DatabaseInstance"

/// Database version
///
/// The database engine type and version.
typealias DatabaseVersion =
  "MYSQL_5_6"
  |"MYSQL_5_7"
  |"MYSQL_8_0"
  |"MYSQL_8_0_18"
  |"MYSQL_8_0_26"
  |"MYSQL_8_0_27"
  |"MYSQL_8_0_28"
  |"MYSQL_8_0_29"
  |"MYSQL_8_0_30"
  |"MYSQL_8_0_31"
  |"MYSQL_8_0_32"
  |"MYSQL_8_0_33"
  |"MYSQL_8_0_34"
  |"MYSQL_8_0_35"
  |"MYSQL_8_0_36"
  |"MYSQL_8_0_37"
  |"MYSQL_8_0_39"
  |"MYSQL_8_0_40"
  |"MYSQL_8_0_41"
  |"MYSQL_8_0_42"
  |"MYSQL_8_0_43"
  |"MYSQL_8_0_44"
  |"MYSQL_8_0_45"
  |"MYSQL_8_0_46"
  |"MYSQL_8_4"
  |"POSTGRES_9_6"
  |"POSTGRES_10"
  |"POSTGRES_11"
  |"POSTGRES_12"
  |"POSTGRES_13"
  |"POSTGRES_14"
  |"POSTGRES_15"
  |"POSTGRES_16"
  |"POSTGRES_17"
  |"POSTGRES_18"
  |"SQLSERVER_2017_STANDARD"
  |"SQLSERVER_2017_ENTERPRISE"
  |"SQLSERVER_2017_EXPRESS"
  |"SQLSERVER_2017_WEB"
  |"SQLSERVER_2019_STANDARD"
  |"SQLSERVER_2019_ENTERPRISE"
  |"SQLSERVER_2019_EXPRESS"
  |"SQLSERVER_2019_WEB"
  |"SQLSERVER_2022_STANDARD"
  |"SQLSERVER_2022_ENTERPRISE"
  |"SQLSERVER_2022_EXPRESS"
  |"SQLSERVER_2022_WEB"

/// Instance tier (machine type)
///
/// Examples: "db-f1-micro", "db-n1-standard-1", "db-custom-1-3840"
typealias Tier = String

/// Data disk type
typealias DataDiskType = "PD_SSD"|"PD_HDD"

/// Availability type
typealias AvailabilityType = "ZONAL"|"REGIONAL"

/// Backup retention unit
typealias RetentionUnit = "COUNT"

/// Settings for the database instance
@gcp.SubResourceHint
open class Settings extends formae.SubResource {
  /// The tier (machine type) for this instance
  @gcp.FieldHint
  tier: Tier

  /// Availability type (ZONAL or REGIONAL)
  @gcp.FieldHint
  availabilityType: String?

  /// Data disk size in GB
  @gcp.FieldHint{
    outputTransformation = formae.transform.toString
  }
  dataDiskSizeGb: Int?

  /// Data disk type (PD_SSD or PD_HDD)
  @gcp.FieldHint
  dataDiskType: String?

  /// Whether storage auto-resize is enabled
  @gcp.FieldHint
  storageAutoResize: Boolean?

  /// User-defined labels
  @gcp.FieldHint
  userLabels: Mapping<String, String>?

  /// IP configuration
  @gcp.FieldHint
  ipConfiguration: IpConfiguration?

  /// Backup configuration
  @gcp.FieldHint
  backupConfiguration: BackupConfiguration?

  /// Maintenance window
  @gcp.FieldHint
  maintenanceWindow: MaintenanceWindow?

  /// Database flags
  @gcp.FieldHint
  databaseFlags: Listing<DatabaseFlag>?
}

/// IP configuration for the instance
@gcp.SubResourceHint
open class IpConfiguration extends formae.SubResource {
  @gcp.FieldHint
  ipv4Enabled: Boolean?

  @gcp.FieldHint
  privateNetwork: String?

  @gcp.FieldHint
  requireSsl: Boolean?

  @gcp.FieldHint
  authorizedNetworks: Listing<AclEntry>?
}

/// Authorized network entry
@gcp.SubResourceHint
open class AclEntry extends formae.SubResource {
  @gcp.FieldHint
  name: String?

  @gcp.FieldHint
  value: String
}

/// Backup configuration
@gcp.SubResourceHint
open class BackupConfiguration extends formae.SubResource {
  @gcp.FieldHint
  enabled: Boolean?

  @gcp.FieldHint
  startTime: String?

  @gcp.FieldHint
  pointInTimeRecoveryEnabled: Boolean?

  @gcp.FieldHint
  backupRetentionSettings: BackupRetentionSettings?
}

/// Backup retention settings
@gcp.SubResourceHint
open class BackupRetentionSettings extends formae.SubResource {
  @gcp.FieldHint
  retainedBackups: Int?

  @gcp.FieldHint
  retentionUnit: RetentionUnit?
}

/// Maintenance window configuration
@gcp.SubResourceHint
open class MaintenanceWindow extends formae.SubResource {
  @gcp.FieldHint
  day: Int?

  @gcp.FieldHint
  hour: Int?

  @gcp.FieldHint
  updateTrack: String?
}

/// Database flag
@gcp.SubResourceHint
open class DatabaseFlag extends formae.SubResource {
  @gcp.FieldHint
  name: String

  @gcp.FieldHint
  value: String
}

open class DatabaseInstanceResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden id: DatabaseInstanceResolvable = (this) {
        property = "Id"
    }

    hidden selfLink: DatabaseInstanceResolvable = (this) {
        property = "selfLink"
    }

    hidden name: DatabaseInstanceResolvable = (this) {
        property = "name"
    }

    hidden connectionName: DatabaseInstanceResolvable = (this) {
        property = "connectionName"
    }
}

/// GCP Cloud SQL Database Instance resource
@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class DatabaseInstance extends formae.Resource {
    hidden parent = this

    /// GCP project ID
    @gcp.FieldHint {
        createOnly = true
    }
    project: String

    /// Name of the instance
    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    /// Database version
    @gcp.FieldHint {
        createOnly = true
    }
    databaseVersion: DatabaseVersion

    /// Region where the instance will be created
    @gcp.FieldHint {
        createOnly = true
    }
    region: gcp.Region

    /// Settings for the instance
    @gcp.FieldHint
    settings: Settings

    /// Root password (only used during creation, not stored)
    @gcp.FieldHint {
        createOnly = true
    }
    rootPassword: String?

    /// Master instance name (for read replicas)
    @gcp.FieldHint {
        createOnly = true
    }
    masterInstanceName: String?

    hidden res: DatabaseInstanceResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
