/// GCP Dataform Workspace
///
/// A development branch of a repository: an editable checkout where SQL
/// workflow code is written before it is committed. Free — it is metadata and a
/// file tree, and it compiles nothing on its own.
///
/// Nested under its repository, which is a path component rather than a body
/// field: the API answers a create carrying it with HTTP 400 "Unknown name
/// \"repository\" at 'workspace': Cannot find field". The plugin drops it from
/// every request and lifts it back out of the path the API reports, so the
/// declared value and stored state agree.
///
/// Declare the repository through its resolvable. That reference is also the
/// teardown order: a repository that still has workspaces refuses to delete
/// with HTTP 400, and formae destroys the consumer of a reference before its
/// producer.
///
/// Every field is immutable — the collection has no patch method at all, so a
/// change is a replacement. Create and delete are synchronous.
///
/// The workspace's contents are not modelled here. Files are written through
/// `writeFile`, `commit`, `push` and friends, which are custom verbs rather
/// than CRUD on a resource.
module gcp.dataform.workspace

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Dataform::Workspace"

open class WorkspaceResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: WorkspaceResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
    parent = "GCP::Dataform::Repository"
    listParam = new Listing<formae.ListProperty> {
        new formae.ListProperty {
            parentProperty = "repository"
            listParameter = "repository"
        }
    }.toList()
}
open class Workspace extends formae.Resource {
    hidden parent = this

    /// Short id (e.g. "my-workspace"). Immutable — it is sent as
    /// ?workspaceId= at creation and is the path afterwards.
    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    /// The repository this workspace belongs to. A path component rather than a
    /// body field: it is dropped from the request and recovered from the
    /// returned path.
    @gcp.FieldHint {
        createOnly = true
    }
    repository: (String|formae.Resolvable)

    /// Whether this workspace stays behind when its repository is moved to
    /// another folder — set, the workspace is deleted instead of moved.
    ///
    /// GCP reports this back as `false` for a workspace that never sent it, so
    /// it carries a provider default rather than staying absent.
    @gcp.FieldHint {
        createOnly = true
        hasProviderDefault = true
    }
    disableMoves: Boolean?

    hidden res: WorkspaceResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
