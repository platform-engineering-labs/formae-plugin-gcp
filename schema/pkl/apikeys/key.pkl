/// GCP API Keys Key
///
/// An API key: the credential a client sends as `?key=...` to identify the
/// calling project to a Google API, plus the restrictions that narrow which
/// callers may use it and which services it may reach.
///
/// Free — a key provisions nothing. It is not inert, though: the key *string*
/// is a bearer credential. It is generated by the server, returned only by the
/// create call and by the separate `getKeyString` method, and this plugin drops
/// it on every path so it never lands in stored state. There is consequently no
/// field here to read it from; use `gcloud services api-keys get-key-string`
/// when the value itself is wanted.
///
/// Global: the path has a location segment but `global` is its only legal
/// value. Create, update and delete are long-running operations.
///
/// Two API behaviours are worth knowing before declaring one:
///
/// * The id is the client-chosen `keyId`, not the server's uuid — that uuid is
///   reported separately as `uid` and is not stored. The id must match
///   `[a-z]([a-z0-9-]{0,61}[a-z0-9])?` and must not itself look like a uuid.
/// * Delete is a **soft** delete. The key stops working and disappears from
///   listings, but reads keep answering for thirty days with a `deleteTime`
///   set (the provisioner treats such a read as not-found), and the id stays
///   reserved for that whole window: re-creating the same `name` inside it is
///   refused with "A key with this id already exists". A rename is therefore
///   the safe way to replace a key.
module gcp.apikeys.key

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::ApiKeys::Key"

/// One service the key may call, and optionally which of its methods.
@gcp.SubResourceHint
open class ApiTarget extends formae.SubResource {
    /// The canonical service name, e.g. "translate.googleapis.com".
    @gcp.FieldHint
    service: String

    /// Methods that may be called. Empty allows all of them. A trailing `*` is
    /// a wildcard, e.g. "google.cloud.translate.v2.TranslateService.*".
    @gcp.FieldHint
    methods: Listing<String>?
}

/// Restrict the key to calls made from named websites.
@gcp.SubResourceHint
open class BrowserKeyRestrictions extends formae.SubResource {
    /// Regular expressions matching allowed HTTP referrers, e.g.
    /// "https://example.com/*".
    @gcp.FieldHint
    allowedReferrers: Listing<String>
}

/// Restrict the key to calls made from named IP addresses.
@gcp.SubResourceHint
open class ServerKeyRestrictions extends formae.SubResource {
    /// Caller IP addresses allowed to use the key.
    @gcp.FieldHint
    allowedIps: Listing<String>
}

/// One Android application allowed to use the key.
@gcp.SubResourceHint
open class AndroidApplication extends formae.SubResource {
    /// The application's package name.
    @gcp.FieldHint
    packageName: String

    /// The signing certificate's SHA-1 fingerprint. **Give this in lower
    /// case.** The API lower-cases what it stores, so an upper-case
    /// declaration — the form `keytool` prints, and the form the API's own
    /// documentation uses as an example — is stored differently from how it was
    /// written and reads as drift on every sync. Both the colon-separated and
    /// bare forms are accepted.
    @gcp.FieldHint
    sha1Fingerprint: String
}

/// Restrict the key to calls made from named Android apps.
@gcp.SubResourceHint
open class AndroidKeyRestrictions extends formae.SubResource {
    /// The allowed applications.
    @gcp.FieldHint
    allowedApplications: Listing<AndroidApplication>
}

/// Restrict the key to calls made from named iOS apps.
@gcp.SubResourceHint
open class IosKeyRestrictions extends formae.SubResource {
    /// Allowed iOS bundle ids.
    @gcp.FieldHint
    allowedBundleIds: Listing<String>
}

/// Where the key may be used from, and what it may reach. Set at most one of
/// the four client restrictions — they describe mutually exclusive kinds of
/// caller — alongside any `apiTargets`.
@gcp.SubResourceHint
open class Restrictions extends formae.SubResource {
    /// Services and methods the key may call. Unset allows every API in the
    /// project, which is why a real key should almost always set it.
    @gcp.FieldHint
    apiTargets: Listing<ApiTarget>?

    /// Allowed HTTP referrers.
    @gcp.FieldHint
    browserKeyRestrictions: BrowserKeyRestrictions?

    /// Allowed caller IP addresses.
    @gcp.FieldHint
    serverKeyRestrictions: ServerKeyRestrictions?

    /// Allowed Android applications.
    @gcp.FieldHint
    androidKeyRestrictions: AndroidKeyRestrictions?

    /// Allowed iOS bundle ids.
    @gcp.FieldHint
    iosKeyRestrictions: IosKeyRestrictions?
}

open class KeyResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: KeyResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class Key extends formae.Resource {
    hidden parent = this

    /// Short id (e.g. "my-api-key"). Sent as ?keyId= on create; the API reports
    /// it back as the last segment of
    /// "projects/{projectNumber}/locations/global/keys/{keyId}" and the
    /// provisioner shortens it again. Must match
    /// `[a-z]([a-z0-9-]{0,61}[a-z0-9])?` and must not look like a uuid.
    ///
    /// Immutable — a PATCH masking `name` is rejected outright — and, because a
    /// deleted id stays reserved for thirty days, a replacement under the same
    /// name cannot succeed inside that window. Prefer a new name.
    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    /// A human-readable name, up to 63 characters. Mutable, and the only field
    /// a person reading the Cloud console will see, since the id is not shown
    /// there.
    @gcp.FieldHint
    displayName: String?

    /// Where the key may be used from and what it may reach. Mutable. An
    /// unrestricted key can call every enabled API in the project.
    @gcp.FieldHint
    restrictions: Restrictions?

    /// Arbitrary key-value metadata for external tooling. Mutable, and echoed
    /// back exactly as sent.
    @gcp.FieldHint
    annotations: Mapping<String, String>?

    /// A service account the key is bound to, so calls made with it are
    /// authorized as that account. Immutable: the API refuses an update mask
    /// containing it, naming the field
    /// ("Update mask contains immutable field(s) \"service_account_email\"").
    @gcp.FieldHint {
        createOnly = true
    }
    serviceAccountEmail: String?

    hidden res: KeyResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
