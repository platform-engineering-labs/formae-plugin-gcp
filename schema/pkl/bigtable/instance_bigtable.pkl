/// GCP Bigtable Instance
///
/// A Bigtable instance containing clusters and tables.
module gcp.bigtable.instance

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Bigtable::Instance"

typealias InstanceType = "PRODUCTION"|"DEVELOPMENT"
typealias StorageType = "SSD"|"HDD"

/// Cluster configuration for Bigtable instance
@gcp.SubResourceHint
open class ClusterConfig extends formae.SubResource {
    /// The location (zone) for the cluster (e.g., "us-central1-a")
    @gcp.FieldHint {
        createOnly = true
    }
    location: String

    /// Storage type for the cluster
    @gcp.FieldHint {
        createOnly = true
    }
    defaultStorageType: StorageType?

    /// Number of nodes (only for PRODUCTION instances)
    @gcp.FieldHint
    serveNodes: Int?
}

open class InstanceResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: InstanceResolvable = (this) {
        property = "name"
    }

    hidden displayName: InstanceResolvable = (this) {
        property = "displayName"
    }
}

/// GCP Bigtable Instance resource
@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class Instance extends formae.Resource {
    hidden parent = this

    @gcp.FieldHint {
        createOnly = true
    }
    project: String

    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    @gcp.FieldHint
    displayName: String

    @gcp.FieldHint {
        createOnly = true
    }
    type: InstanceType

    @gcp.FieldHint
    labels: Mapping<String, String>?

    /// Cluster configurations for the instance (at least one required for Create)
    /// This is createOnly - not returned by Read operations as clusters are managed separately
    @gcp.FieldHint {
        createOnly = true
    }
    clusters: Mapping<String, ClusterConfig>?

    hidden res: InstanceResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
