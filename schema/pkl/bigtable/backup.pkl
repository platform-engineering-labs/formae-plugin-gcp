/// GCP Bigtable Backup
///
/// A backup of a Bigtable table.
module gcp.bigtable.backup

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Bigtable::Backup"

@gcp.SubResourceHint
open class EncryptionInfo extends formae.SubResource {
  @gcp.FieldHint
  encryptionType: String

  @gcp.FieldHint
  kmsKeyVersion: String?
}

open class BackupResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: BackupResolvable = (this) {
        property = "name"
    }

    hidden sourceTable: BackupResolvable = (this) {
        property = "sourceTable"
    }
}

/// GCP Bigtable Backup resource
@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class Backup extends formae.Resource {
    hidden parent = this

    @gcp.FieldHint {
        createOnly = true
    }
    project: String

    @gcp.FieldHint {
        createOnly = true
    }
    instance: (String|formae.Resolvable)

    @gcp.FieldHint {
        createOnly = true
    }
    cluster: (String|formae.Resolvable)

    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    @gcp.FieldHint {
        createOnly = true
    }
    sourceTable: (String|formae.Resolvable)

    @gcp.FieldHint
    expireTime: String

    hidden res: BackupResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
