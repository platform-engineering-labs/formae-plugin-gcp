/// GCP Bigtable Materialized View
///
/// A continuously-updated view over Bigtable data, defined by a SQL query. A
/// table serves what was written to it; a materialized view serves a
/// precomputed answer instead.
///
/// Views live under their instance (`.../instances/{instance}/materializedViews/{name}`).
module gcp.bigtable.materialized_view

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Bigtable::MaterializedView"

open class MaterializedViewResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: MaterializedViewResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class MaterializedView extends formae.Resource {
    hidden parent = this

    /// Short view id. Immutable.
    @gcp.FieldHint { createOnly = true }
    name: String

    /// Short id of the owning instance. A path component, not a body field —
    /// pass `inst.res.name` so formae creates the instance first.
    @gcp.FieldHint { createOnly = true }
    instance: (String|formae.Resolvable)

    /// The SQL query defining the view. Immutable — the API has no way to
    /// redefine a view in place.
    @gcp.FieldHint { createOnly = true }
    query: String

    /// Refuses deletion while set. Patchable.
    @gcp.FieldHint { hasProviderDefault = true }
    deletionProtection: Boolean?

    hidden res: MaterializedViewResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
