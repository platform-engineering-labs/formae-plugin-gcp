/// GCP Bigtable MaterializedView
///
/// A continuously updated view over Bigtable data, defined by a GoogleSQL
/// query. It belongs to an instance, not to a cluster or a single table - the
/// query names whatever it reads.
module gcp.bigtable.materialized_view

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Bigtable::MaterializedView"

open class MaterializedViewResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: MaterializedViewResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class MaterializedView extends formae.Resource {
    hidden parent = this

    /// GCP project ID.
    @gcp.FieldHint {
        createOnly = true
    }
    project: String

    /// The instance holding the view. A short instance name or an Instance
    /// resolvable. A path component, not a body field.
    @gcp.FieldHint {
        createOnly = true
    }
    instance: (String|formae.Resolvable)

    /// Short view id. Immutable.
    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    /// The GoogleSQL query defining the view. Immutable.
    @gcp.FieldHint {
        createOnly = true
    }
    query: String

    /// Refuse deletion while set.
    @gcp.FieldHint
    deletionProtection: Boolean?

    /// Per-cluster state of the view. Set by the API.
    @gcp.FieldHint { hasProviderDefault = true }
    clusterStates: Mapping<String, String>?

    /// Optimistic locking token. Set by the API.
    @gcp.FieldHint { hasProviderDefault = true }
    etag: String?

    hidden res: MaterializedViewResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
