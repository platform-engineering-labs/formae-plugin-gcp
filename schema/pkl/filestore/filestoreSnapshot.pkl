/// GCP Filestore Snapshot
///
/// A point-in-time copy of an `Instance`'s file shares, stored inside the
/// instance itself. Unlike a `Backup`, a snapshot does not outlive its
/// instance - deleting the instance deletes its snapshots.
module gcp.filestore.filestoreSnapshot

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Filestore::Snapshot"

open class SnapshotResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: SnapshotResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class Snapshot extends formae.Resource {
    hidden parent = this

    /// Short snapshot id. Immutable.
    @gcp.FieldHint { createOnly = true }
    name: String

    /// Zone of the instance. A path component, not a body field.
    @gcp.FieldHint { createOnly = true }
    location: String

    /// The instance this snapshot belongs to. A short instance name or an
    /// Instance resolvable. A path component, not a body field.
    @gcp.FieldHint { createOnly = true }
    instance: (String|formae.Resolvable)

    @gcp.FieldHint
    description: String?

    @gcp.FieldHint
    labels: Mapping<String, String>?

    /// CREATING, READY or DELETING. Set by the API.
    @gcp.FieldHint { hasProviderDefault = true }
    state: String?

    /// Bytes used by the file system at snapshot time, as a string. Set by the
    /// API.
    @gcp.FieldHint { hasProviderDefault = true }
    filesystemUsedBytes: String?

    hidden res: SnapshotResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
