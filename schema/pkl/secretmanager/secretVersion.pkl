/// GCP Secret Manager SecretVersion
///
/// A SecretVersion holds the actual secret material for a parent Secret. The
/// payload is write-only: the create call sends it (the provisioner base64
/// encodes it for the API) and it is never returned on read, exactly like
/// Cloud SQL's `rootPassword`. Versions are immutable, so every field is
/// createOnly; a payload change plans a replace (add a new version).
///
/// A consumer references the payload with `version.res.secretValue`, so the
/// value never has to be restated in the consumer's own forma.
module gcp.secretmanager.secretVersion

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::SecretManager::SecretVersion"

open class SecretVersionResolvable extends formae.ScalarSecretResolvable {
    hidden type = module.type
    hidden valueProperty = "data"

    /// Full version path "projects/{project}/secrets/{secret}/versions/{n}".
    hidden name: SecretVersionResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class SecretVersion extends formae.Secret {
    hidden parent = this

    hidden valueProperty = "data"

    /// Parent secret's short ID (e.g. "my-secret"), or its full path
    /// "projects/{project}/secrets/{my-secret}". A short ID is expanded using
    /// the target's project.
    ///
    /// Optional in the type but required on create (requiredOnCreate): a
    /// discovered version is identified by its full `name` alone, so Read does
    /// not echo `secret` back (echoing it would drift the createOnly resolvable
    /// against its short-id/full-path desired form).
    @gcp.FieldHint {
        createOnly = true
        requiredOnCreate = true
    }
    secret: (String|formae.Resolvable)?

    /// Secret payload as a UTF-8 string. Write-only: sent on create, never
    /// returned on read (so it is optional in the type but required on create).
    /// The provisioner base64 encodes it for the API. Consumers read it back
    /// with `version.res.secretValue` rather than restating the value.
    @gcp.FieldHint {
        createOnly = true
        writeOnly = true
        requiredOnCreate = true
    }
    data: (String|formae.Value|formae.SecretValue)?

    hidden res: SecretVersionResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
