/// GCP Secret Manager SecretVersion
///
/// A SecretVersion holds the actual secret material for a parent Secret. The
/// payload is write-only: the create call sends it (the provisioner base64
/// encodes it for the API) and it is never returned on read, exactly like
/// Cloud SQL's `rootPassword`. Versions are immutable, so every field is
/// createOnly; a payload change plans a replace (add a new version).
module gcp.secretmanager.secretVersion

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::SecretManager::SecretVersion"

open class SecretVersionResolvable extends formae.Resolvable {
    hidden type = module.type

    /// Full version path "projects/{project}/secrets/{secret}/versions/{n}".
    hidden name: SecretVersionResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
    // Versions live under a parent secret and have no project-wide list, so they
    // cannot be enumerated for discovery without walking every secret. The Secret
    // is the discoverable unit; a version is only ever listed under a known secret.
    discoverable = false
}
open class SecretVersion extends formae.Resource {
    hidden parent = this

    /// Parent secret's short ID (e.g. "my-secret"), or its full path
    /// "projects/{project}/secrets/{my-secret}". A short ID is expanded using
    /// the target's project.
    @gcp.FieldHint {
        createOnly = true
    }
    secret: (String|formae.Resolvable)

    /// Secret payload as a UTF-8 string. Write-only: sent on create, never
    /// returned on read. The provisioner base64 encodes it for the API.
    @gcp.FieldHint {
        createOnly = true
        writeOnly = true
    }
    data: String

    hidden res: SecretVersionResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
