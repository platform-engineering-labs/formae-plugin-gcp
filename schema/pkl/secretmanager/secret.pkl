/// GCP Secret Manager Secret
///
/// A Secret is a logical secret whose value and versions can be accessed.
/// The secret material itself lives in SecretVersions (not yet implemented).
module gcp.secretmanager.secret

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::SecretManager::Secret"

/// Empty marker selecting automatic (Google-managed) replication.
@gcp.SubResourceHint
open class AutomaticReplication extends formae.SubResource {
}

@gcp.SubResourceHint
open class Replication extends formae.SubResource {
    @gcp.FieldHint
    automatic: AutomaticReplication?
}

open class SecretResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: SecretResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class Secret extends formae.Resource {
    hidden parent = this

    /// Short secret ID (e.g. "my-secret"). The API returns the full path
    /// "projects/{project}/secrets/{id}".
    @gcp.FieldHint {
        createOnly = true
    }
    name: String

    /// Replication policy (required by the API). Use automatic for the common
    /// Google-managed case.
    @gcp.FieldHint {
        createOnly = true
    }
    replication: Replication

    @gcp.FieldHint
    labels: Mapping<String, String>?

    hidden res: SecretResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
