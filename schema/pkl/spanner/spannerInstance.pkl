/// GCP Spanner Instance
///
/// The compute and storage a set of Spanner databases runs on. Unlike most of
/// what this plugin manages, an instance is billed for as long as it exists —
/// the smallest regional instance is 100 processing units — so a forma that
/// declares one is spending money until it is destroyed.
module gcp.spanner.spannerInstance

import "../gcp.pkl"
import "@formae/formae.pkl"

const type = "GCP::Spanner::Instance"

open class InstanceResolvable extends formae.Resolvable {
    hidden type = module.type

    hidden name: InstanceResolvable = (this) {
        property = "name"
    }
}

@gcp.ResourceHint {
    type = module.type
    identifier = "name"
}
open class Instance extends formae.Resource {
    hidden parent = this

    /// Short instance id, unique in the project. Immutable.
    @gcp.FieldHint { createOnly = true }
    name: String

    /// The project holding the instance.
    @gcp.FieldHint { createOnly = true }
    project: (String|formae.Resolvable)?

    /// The instance configuration, which fixes where the data lives, as a full
    /// path "projects/{p}/instanceConfigs/{config}" or a short config id such
    /// as "regional-europe-central2". Immutable.
    @gcp.FieldHint { createOnly = true }
    config: String

    /// Human-readable name, 4 to 30 characters. Required by the API.
    @gcp.FieldHint
    displayName: String

    /// Compute capacity in processing units; 100 is the smallest instance and
    /// 1000 makes a node. Set this or nodeCount, not both.
    @gcp.FieldHint { hasProviderDefault = true }
    processingUnits: Int?

    /// Compute capacity in nodes. Set this or processingUnits, not both.
    @gcp.FieldHint { hasProviderDefault = true }
    nodeCount: Int?

    @gcp.FieldHint
    labels: Mapping<String, String>?

    /// CREATING or READY - server-reported.
    @gcp.FieldHint { hasProviderDefault = true }
    state: String?

    hidden res: InstanceResolvable = new {
        label = parent.label
        stack = parent.stack?.label
    }
}
